+                } catch (Throwable t) {
+                    LOGGER.warn("NeoForge handleServerStarting failed (Folia-first / FML incomplete): {}", (Object) t.toString());
+                    LOGGER.debug("NeoForge handleServerStarting", t);
+                }
                 String doneTime = String.format(java.util.Locale.ROOT, "%.3fs", (double) (Util.getNanos() - serverStartTime) / 1.0E9D);
                 LOGGER.info("Done ({})! For help, type \"help\"", doneTime);
+                try {
