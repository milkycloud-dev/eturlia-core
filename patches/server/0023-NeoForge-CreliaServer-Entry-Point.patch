     public void stopServer() {
         // Folia start - region threading
+        try {
+            ServerLifecycleHooks.handleServerStopping(this); // NeoForge - fire ServerStoppingEvent
+        } catch (Throwable t) {
+            LOGGER.warn("NeoForge handleServerStopping failed (Folia-first / FML incomplete): {}", (Object) t.toString());
+            LOGGER.debug("NeoForge handleServerStopping", t);
+        }
         // halt scheduler
         // don't wait, we may be on a scheduler thread
         io.papermc.paper.threadedregions.TickRegions.getScheduler().halt(false, 0L);
@@ -1153,6 +1165,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     }
     public void stopPart2() {
         // Folia end - region threading
+        try {
+            ServerLifecycleHooks.handleServerStopped(this); // NeoForge - fire ServerStoppedEvent
+        } catch (Throwable t) {
+            LOGGER.warn("NeoForge handleServerStopped failed (Folia-first / FML incomplete): {}", (Object) t.toString());
+            LOGGER.debug("NeoForge handleServerStopped", t);
+        }
         this.resources.close();
 
         try {
