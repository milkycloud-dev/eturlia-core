+                    LOGGER.debug("NeoForge handleServerStarted", t);
+                }
                 for (;;) {
                     try {
                         Thread.sleep(Long.MAX_VALUE);
                     } catch (final InterruptedException ex) {}
                 }
             }
@@ -1672,6 +1721,9 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             return scheduledEnd - System.nanoTime() > targetBuffer;
         };
         this.server.spark.tickStart(); // Paper - spark
+        // NeoForge start - server tick pre event
