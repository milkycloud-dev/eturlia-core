From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: milkycloud-dev <uberlion1@gmail.com>
Date: Tue, 11 Aug 2026 11:06:52 +0300
Subject: [PATCH] Let mod mixins find the vanilla shapes Paper rewrote


diff --git a/src/main/java/io/papermc/paper/PaperBootstrap.java b/src/main/java/io/papermc/paper/PaperBootstrap.java
index 8b3df5547f33ba0d1fe2badb417849516d5241d7..46e50a62ea863baa6df74aa1dab12390554ef693 100644
--- a/src/main/java/io/papermc/paper/PaperBootstrap.java
+++ b/src/main/java/io/papermc/paper/PaperBootstrap.java
@@ -20,7 +20,7 @@ public final class PaperBootstrap {
 
         // ServerModLoader runs after Bootstrap.bootStrap() inside net.minecraft.server.Main
         // (NeoForge registries require a completed Bootstrap).
-        Main.main(options);
+        Main.eturlia$bootFromOptions(options);
     }
 
     private static List<String> getStartupVersionMessages() {
diff --git a/src/main/java/net/minecraft/data/tags/TagsProvider.java b/src/main/java/net/minecraft/data/tags/TagsProvider.java
index 86051d1e68aadd623f55417834b27abb6c74e070..24e55194f9e4a53c358a4c806f74d791a08a41c4 100644
--- a/src/main/java/net/minecraft/data/tags/TagsProvider.java
+++ b/src/main/java/net/minecraft/data/tags/TagsProvider.java
@@ -25,6 +25,17 @@ import net.minecraft.tags.TagFile;
 import net.minecraft.tags.TagKey;
 
 public abstract class TagsProvider<T> implements DataProvider {
+    // Eturlia start - NeoForge adds this for data generators; mods @Shadow it
+    /**
+     * NeoForge's data-generation helper.
+     *
+     * <p>Never used by a running server - data generation happens at build time - but mods
+     * such as puzzleslib shadow it, and a mixin that cannot resolve a shadowed field aborts
+     * the whole boot.</p>
+     */
+    protected net.neoforged.neoforge.common.data.ExistingFileHelper existingFileHelper;
+    // Eturlia end
+
     protected final PackOutput.PathProvider pathProvider;
     private final CompletableFuture<HolderLookup.Provider> lookupProvider;
     private final CompletableFuture<Void> contentsDone = new CompletableFuture<>();
diff --git a/src/main/java/net/minecraft/server/Main.java b/src/main/java/net/minecraft/server/Main.java
index d615aedbc59e67d6c4d624a9c57cc7897dcdd0bf..29a90b3317f617956a64cbd945852d939e6d30ab 100644
--- a/src/main/java/net/minecraft/server/Main.java
+++ b/src/main/java/net/minecraft/server/Main.java
@@ -90,7 +90,16 @@ public class Main {
     public Main() {}
 
     @DontObfuscate
-    public static void main(final OptionSet optionset) { // CraftBukkit / Paper entry
+    /**
+     * CraftBukkit/Paper entry point.
+     *
+     * <p>Deliberately <b>not</b> named {@code main}: mods target Mojang's
+     * {@code main(String[])} by name only, and a second overload makes that reference
+     * ambiguous - WorldWeaver's {@code world_folder.MainMixin} resolves to this method,
+     * finds no {@code validateAndCreateAccess} call in it, and fails its injection check
+     * hard enough to abort the boot.</p>
+     */
+    public static void eturlia$bootFromOptions(final OptionSet optionset) {
         ETURLIA$OPTION_SET.set(optionset);
         try {
             main(new String[0]); // Eturlia: Mojang-shaped entry for mod mixins
diff --git a/src/main/java/net/minecraft/world/entity/LivingEntity.java b/src/main/java/net/minecraft/world/entity/LivingEntity.java
index ed67735907e3f0fe55030b14192dd59812a27eed..a861590054b2d3494dbcbbb7fc6c0a9e6600a893 100644
--- a/src/main/java/net/minecraft/world/entity/LivingEntity.java
+++ b/src/main/java/net/minecraft/world/entity/LivingEntity.java
@@ -1598,7 +1598,13 @@ public abstract class LivingEntity extends Entity implements Attackable {
                     }
                     // Paper end - Check distance in entity interactions
 
-                    this.knockback(0.4000000059604645D, d0, d1, entity1, entity1 == null ? io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.DAMAGE : io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.ENTITY_ATTACK); // CraftBukkit // Paper - knockback events
+                    // Eturlia start - keep Mojang's call shape so mod injectors still find it
+                    this.eturlia$knockbackAttacker = entity1;
+                    this.eturlia$knockbackCause = entity1 == null
+                            ? io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.DAMAGE
+                            : io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.ENTITY_ATTACK;
+                    this.knockback(0.4000000059604645D, d0, d1); // CraftBukkit // Paper - knockback events
+                    // Eturlia end
                     if (!flag) {
                         this.indicateDamage(d0, d1);
                     }
@@ -1988,9 +1994,28 @@ public abstract class LivingEntity extends Entity implements Attackable {
         loottable.getRandomItems(lootparams, this.getLootTableSeed(), this::spawnAtLocation);
     }
 
+    // Eturlia start - carries the attacker/cause for the call in hurt, which uses Mojang's shape
+    /** Attacker for the next {@link #knockback(double, double, double)} call, consumed once. */
+    @Nullable
+    private Entity eturlia$knockbackAttacker;
+
+    /** Cause for the next {@link #knockback(double, double, double)} call, consumed once. */
+    @Nullable
+    private io.papermc.paper.event.entity.EntityKnockbackEvent.Cause eturlia$knockbackCause;
+    // Eturlia end
+
     public void knockback(double strength, double x, double z) {
         // CraftBukkit start - EntityKnockbackEvent
-        this.knockback(strength, x, z, null, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.UNKNOWN); // Paper - knockback events
+        // Eturlia start - hurt() sets these immediately before calling, so Paper's event keeps
+        // the attacker and cause it had before the call was reshaped for mod injectors.
+        Entity eturliaAttacker = this.eturlia$knockbackAttacker;
+        io.papermc.paper.event.entity.EntityKnockbackEvent.Cause eturliaCause = this.eturlia$knockbackCause;
+        this.eturlia$knockbackAttacker = null;
+        this.eturlia$knockbackCause = null;
+        this.knockback(strength, x, z, eturliaAttacker, eturliaCause == null
+                ? io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.UNKNOWN
+                : eturliaCause);
+        // Eturlia end
     }
 
     public void knockback(double d0, double d1, double d2, @Nullable Entity attacker, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause cause) { // Paper - knockback events
