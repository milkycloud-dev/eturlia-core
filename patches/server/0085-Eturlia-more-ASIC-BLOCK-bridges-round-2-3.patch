+    // Eturlia/NeoForge: Supplementaries @Invoker invokeOnItemUse targets this private method
+    private InteractionResult onItemUse(UseOnContext context, java.util.function.Function<UseOnContext, InteractionResult> callback) {
+        net.minecraft.world.entity.player.Player entityhuman = context.getPlayer();
+        BlockPos blockposition = context.getClickedPos();
+        if (entityhuman != null && !entityhuman.getAbilities().mayBuild && !this.canPlaceOnBlockInAdventureMode(new BlockInWorld(context.getLevel(), blockposition, false))) {
+            return InteractionResult.PASS;
+        } else {
+            InteractionResult enuminteractionresult = callback.apply(context);
+            if (entityhuman != null && enuminteractionresult.indicateItemUse()) {
+                entityhuman.awardStat(Stats.ITEM_USED.get(this.getItem()));
+            }
+            return enuminteractionresult;
+        }
+    }
