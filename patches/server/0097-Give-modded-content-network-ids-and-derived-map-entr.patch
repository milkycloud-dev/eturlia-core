From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: milkycloud-dev <uberlion1@gmail.com>
Date: Tue, 11 Aug 2026 09:45:30 +0300
Subject: [PATCH] Give modded content network ids and derived-map entries


diff --git a/src/main/java/net/minecraft/server/Main.java b/src/main/java/net/minecraft/server/Main.java
index f1baba4b35f167c56c1912e89fe02d51004bf3e9..d615aedbc59e67d6c4d624a9c57cc7897dcdd0bf 100644
--- a/src/main/java/net/minecraft/server/Main.java
+++ b/src/main/java/net/minecraft/server/Main.java
@@ -168,6 +168,31 @@ public class Main {
                 // Do not abort Folia boot — FML scan already ran under ModLauncher.
                 LOGGER.error("NeoForge ServerModLoader.load() failed (continuing Folia boot; mods may be partially uninitialized)", cause);
             }
+            // Eturlia start - mods have registered their blocks by now, but nothing has given
+            // those states a network id yet (NeoForge does it from registry callbacks we do not carry).
+            try {
+                int eturliaStates = net.minecraft.world.level.block.Block.eturlia$rebuildStateIds();
+                if (eturliaStates > 0) {
+                    LOGGER.info("Eturlia: assigned network ids to {} modded block states", eturliaStates);
+                }
+            } catch (RuntimeException | LinkageError eturliaError) {
+                LOGGER.error("Eturlia: failed to assign network ids to modded block states; "
+                        + "clients will be disconnected while reading chunks", eturliaError);
+            }
+            // Eturlia end
+            // Eturlia start - same story for the other maps NeoForge keeps via registry callbacks
+            try {
+                int eturliaBlockItems = net.minecraft.world.item.Item.eturlia$rebuildBlockItemMap();
+                int eturliaPoi = net.minecraft.world.entity.ai.village.poi.PoiTypes.eturlia$rebuildStateMap();
+                if (eturliaBlockItems > 0 || eturliaPoi > 0) {
+                    LOGGER.info("Eturlia: registered {} modded block items and {} point-of-interest states",
+                            eturliaBlockItems, eturliaPoi);
+                }
+            } catch (RuntimeException | LinkageError eturliaError) {
+                LOGGER.error("Eturlia: failed to rebuild the modded block-item / point-of-interest maps",
+                        eturliaError);
+            }
+            // Eturlia end
             Util.startTimerHackThread();
             Path path1 = Paths.get("server.properties");
             DedicatedServerSettings dedicatedserversettings = new DedicatedServerSettings(optionset); // CraftBukkit - CLI argument support
diff --git a/src/main/java/net/minecraft/world/entity/ai/village/poi/PoiTypes.java b/src/main/java/net/minecraft/world/entity/ai/village/poi/PoiTypes.java
index faf3e38d00695e2b9189753e36608410a8825b35..8b8fb97bf49dc7b1906301ab029e1035f5f1a86f 100644
--- a/src/main/java/net/minecraft/world/entity/ai/village/poi/PoiTypes.java
+++ b/src/main/java/net/minecraft/world/entity/ai/village/poi/PoiTypes.java
@@ -126,4 +126,28 @@ public class PoiTypes {
         register(registry, LODESTONE, getBlockStates(Blocks.LODESTONE), 0, 1);
         return register(registry, LIGHTNING_ROD, getBlockStates(Blocks.LIGHTNING_ROD), 0, 1);
     }
+
+    // Eturlia start - modded points of interest are missing from TYPE_BY_STATE
+    /**
+     * Binds every registered point of interest to its matching block states.
+     *
+     * <p>The vanilla bootstrap only walks the types it registers itself. Existing entries win,
+     * so this never overwrites a vanilla mapping.</p>
+     *
+     * @return how many state-to-type mappings were added
+     */
+    public static int eturlia$rebuildStateMap() {
+        int added = 0;
+
+        for (Holder.Reference<PoiType> holder : net.minecraft.core.registries.BuiltInRegistries.POINT_OF_INTEREST_TYPE.holders().toList()) {
+            for (BlockState state : holder.value().matchingStates()) {
+                if (TYPE_BY_STATE.putIfAbsent(state, holder) == null) {
+                    added++;
+                }
+            }
+        }
+
+        return added;
+    }
+    // Eturlia end
 }
diff --git a/src/main/java/net/minecraft/world/item/Item.java b/src/main/java/net/minecraft/world/item/Item.java
index cdc1d162baf6393d0e1e1c5f8482e4c34fc2536c..14060552b1432d8c4f178b52933b3e188f78e499 100644
--- a/src/main/java/net/minecraft/world/item/Item.java
+++ b/src/main/java/net/minecraft/world/item/Item.java
@@ -532,4 +532,27 @@ public class Item implements FeatureElement, ItemLike {
             };
         }
     }
+
+    // Eturlia start - modded block items are missing from BY_BLOCK
+    /**
+     * Re-runs {@link BlockItem#registerBlocks} for every registered block item.
+     *
+     * <p>{@code Items}' static initialiser only covers vanilla, so without this
+     * {@link #byBlock} answers {@code AIR} for anything a mod added. Repeating the call for
+     * vanilla items is harmless - it writes the same mapping again.</p>
+     *
+     * @return how many block-to-item mappings were added
+     */
+    public static int eturlia$rebuildBlockItemMap() {
+        int before = BY_BLOCK.size();
+
+        for (Item item : BuiltInRegistries.ITEM) {
+            if (item instanceof BlockItem blockItem) {
+                blockItem.registerBlocks(BY_BLOCK, item);
+            }
+        }
+
+        return BY_BLOCK.size() - before;
+    }
+    // Eturlia end
 }
diff --git a/src/main/java/net/minecraft/world/level/block/Block.java b/src/main/java/net/minecraft/world/level/block/Block.java
index dab36c16927f6e62769067a1739a5c527fb777b8..dc70b0ffaee8c7dba5597d3bca56173da9078877 100644
--- a/src/main/java/net/minecraft/world/level/block/Block.java
+++ b/src/main/java/net/minecraft/world/level/block/Block.java
@@ -630,4 +630,32 @@ import org.slf4j.Logger;
             return i;
         }
     }
+
+    // Eturlia start - modded block states need a network id
+    /**
+     * Adds every block state that is missing from {@link #BLOCK_STATE_REGISTRY} to it.
+     *
+     * <p>Call once after mod loading; the registry is frozen by then, so iteration order is
+     * stable and matches the order the client rebuilds its own id map in.</p>
+     *
+     * @return how many states were added
+     */
+    public static int eturlia$rebuildStateIds() {
+        int added = 0;
+
+        for (Block block : BuiltInRegistries.BLOCK) {
+            for (BlockState state : block.getStateDefinition().getPossibleStates()) {
+                if (Block.BLOCK_STATE_REGISTRY.getId(state) == -1) {
+                    Block.BLOCK_STATE_REGISTRY.add(state);
+                    state.initCache();
+                    added++;
+                }
+            }
+
+            block.getLootTable();
+        }
+
+        return added;
+    }
+    // Eturlia end
 }
diff --git a/src/main/java/net/minecraft/world/level/chunk/LinearPalette.java b/src/main/java/net/minecraft/world/level/chunk/LinearPalette.java
index f4c3f2a49b8d023b8ef67529eba30cf31467d8bf..bad8687e2220e12dec1931b694d9d37649a0a399 100644
--- a/src/main/java/net/minecraft/world/level/chunk/LinearPalette.java
+++ b/src/main/java/net/minecraft/world/level/chunk/LinearPalette.java
@@ -92,7 +92,14 @@ public class LinearPalette<T> implements Palette<T> {
         buf.writeVarInt(this.size);
 
         for (int i = 0; i < this.size; i++) {
-            buf.writeVarInt(this.registry.getId(this.values[i]));
+            // Eturlia start - a -1 means the value never got a network id, and the client
+            // would fail this chunk with an unattributable "No value with id -1". Name it here.
+            int eturliaId = this.registry.getId(this.values[i]);
+            if (eturliaId == -1) {
+                eturlia$reportUnmapped(this.values[i]);
+            }
+            buf.writeVarInt(eturliaId);
+            // Eturlia end
         }
     }
 
@@ -116,4 +123,27 @@ public class LinearPalette<T> implements Palette<T> {
     public Palette<T> copy() {
         return new LinearPalette<>(this.registry, (T[])((Object[])this.values.clone()), this.resizeHandler, this.bits, this.size);
     }
+
+    // Eturlia start - one line per distinct unmapped entry, then stay quiet.
+    private static final java.util.Set<String> eturlia$reportedUnmapped =
+            java.util.concurrent.ConcurrentHashMap.newKeySet();
+
+    private static void eturlia$reportUnmapped(Object value) {
+        String describe;
+        try {
+            if (value instanceof net.minecraft.core.Holder<?> holder) {
+                describe = "Holder[" + holder.getClass().getName() + "] kind=" + holder.kind()
+                        + " key=" + holder.unwrapKey().map(Object::toString).orElse("<none>");
+            } else {
+                describe = String.valueOf(value) + " (" + value.getClass().getName() + ")";
+            }
+        } catch (RuntimeException e) {
+            describe = "<undescribable " + e + ">";
+        }
+        if (eturlia$reportedUnmapped.add(describe)) {
+            org.slf4j.LoggerFactory.getLogger("EturliaPalette")
+                    .error("Palette entry has no network id (wrote -1): {}", describe);
+        }
+    }
+    // Eturlia end
 }
