     private static final ResourceLocation CUSTOM_REGISTER = ResourceLocation.withDefaultNamespace("register");
     private static final ResourceLocation CUSTOM_UNREGISTER = ResourceLocation.withDefaultNamespace("unregister");
 
+    // Eturlia - NeoForge network handshake start
+    /** Connection type negotiated during configuration; VANILLA until a modded payload arrives. */
+    protected net.neoforged.neoforge.network.connection.ConnectionType eturlia$connectionType =
+            net.neoforged.neoforge.network.connection.ConnectionType.OTHER;
+
+    @Override
+    public net.minecraft.network.Connection getConnection() {
+        return this.connection;
+    }
+
+    @Override
