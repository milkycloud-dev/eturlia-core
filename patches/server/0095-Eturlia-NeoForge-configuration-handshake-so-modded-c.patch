diff --git a/src/main/java/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java b/src/main/java/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
index b2a4ae4388758f89fcd0dc3b0c4c03bf46fa5470..14adde9c952fb9e301790720acd2cc7f994d0865 100644
--- a/src/main/java/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
+++ b/src/main/java/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
@@ -22,19 +22,28 @@ public interface CustomPacketPayload {
     }
 
     static <B extends FriendlyByteBuf> StreamCodec<B, CustomPacketPayload> codec(
-        CustomPacketPayload.FallbackProvider<B> unknownCodecFactory, List<CustomPacketPayload.TypeAndCodec<? super B, ?>> types
+        CustomPacketPayload.FallbackProvider<B> unknownCodecFactory, List<CustomPacketPayload.TypeAndCodec<? super B, ?>> types,
+        net.minecraft.network.ConnectionProtocol protocol, net.minecraft.network.protocol.PacketFlow packetFlow // Eturlia - NeoForge payload codecs
     ) {
         final Map<ResourceLocation, StreamCodec<? super B, ? extends CustomPacketPayload>> map = types.stream()
             .collect(Collectors.toUnmodifiableMap(type -> type.type().id(), CustomPacketPayload.TypeAndCodec::codec));
         return new StreamCodec<B, CustomPacketPayload>() {
             private StreamCodec<? super B, ? extends CustomPacketPayload> findCodec(ResourceLocation id) {
                 StreamCodec<? super B, ? extends CustomPacketPayload> streamCodec = map.get(id);
+                // Eturlia start - NeoForge payload codecs: consult the mod network registry before
+                // the vanilla discard path, or NeoForge payloads are cast to DiscardedPayload and
+                // the encoder kills the connection with an internal netty exception.
+                if (streamCodec == null) {
+                    streamCodec = net.neoforged.neoforge.network.registration.NetworkRegistry.getCodec(id, protocol, packetFlow);
+                }
+                // Eturlia end - NeoForge payload codecs
                 return streamCodec != null ? streamCodec : unknownCodecFactory.create(id);
             }
 
             private <T extends CustomPacketPayload> void writeCap(B value, CustomPacketPayload.Type<T> id, CustomPacketPayload payload) {
                 value.writeResourceLocation(id.id());
-                StreamCodec<B, T> streamCodec = this.findCodec(id.id);
+                @SuppressWarnings("unchecked") // Eturlia - decompiler dropped this cast; the file only compiles now that it is patched
+                StreamCodec<B, T> streamCodec = (StreamCodec<B, T>) this.findCodec(id.id);
                 streamCodec.encode(value, (T)payload);
             }
 
