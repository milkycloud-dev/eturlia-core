diff --git a/src/main/java/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/src/main/java/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index ea99a4e39cdfb4eeebc299030f7768b9c684df4e..67a4ad5754492533a49216ce39d08ab4cf832505 100644
--- a/src/main/java/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/src/main/java/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -160,8 +160,57 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
     private static final ResourceLocation CUSTOM_REGISTER = ResourceLocation.withDefaultNamespace("register");
     private static final ResourceLocation CUSTOM_UNREGISTER = ResourceLocation.withDefaultNamespace("unregister");
 
+    // Eturlia - NeoForge network handshake start
+    /** Connection type negotiated during configuration; VANILLA until a modded payload arrives. */
+    protected net.neoforged.neoforge.network.connection.ConnectionType eturlia$connectionType =
+            net.neoforged.neoforge.network.connection.ConnectionType.OTHER;
+
+    @Override
+    public net.minecraft.network.Connection getConnection() {
+        return this.connection;
+    }
+
+    @Override
+    public net.neoforged.neoforge.network.connection.ConnectionType getConnectionType() {
+        return this.eturlia$connectionType;
+    }
+
+    @Override
+    public net.minecraft.util.thread.ReentrantBlockableEventLoop<?> getMainThreadEventLoop() {
+        return this.server;
+    }
+
+    @Override
+    public void send(net.minecraft.network.protocol.common.custom.CustomPacketPayload payload) {
+        this.send(new net.minecraft.network.protocol.common.ClientboundCustomPayloadPacket(payload));
+    }
+    // Eturlia - NeoForge network handshake end
+
     @Override
     public void handleCustomPayload(ServerboundCustomPayloadPacket packet) {
+        // Eturlia start - NeoForge network handshake: register/unregister and modded payloads
+        if (packet.payload() instanceof net.neoforged.neoforge.network.payload.MinecraftRegisterPayload registerPayload) {
+            net.neoforged.neoforge.network.registration.NetworkRegistry.onMinecraftRegister(this.getConnection(), registerPayload.newChannels());
+            return;
+        }
+        if (packet.payload() instanceof net.neoforged.neoforge.network.payload.MinecraftUnregisterPayload unregisterPayload) {
+            net.neoforged.neoforge.network.registration.NetworkRegistry.onMinecraftUnregister(this.getConnection(), unregisterPayload.forgottenChannels());
+            return;
+        }
+        if (packet.payload() instanceof net.neoforged.neoforge.network.payload.CommonVersionPayload commonVersionPayload) {
+            net.neoforged.neoforge.network.registration.NetworkRegistry.checkCommonVersion(this, commonVersionPayload);
+            return;
+        }
+        if (packet.payload() instanceof net.neoforged.neoforge.network.payload.CommonRegisterPayload commonRegisterPayload) {
+            net.neoforged.neoforge.network.registration.NetworkRegistry.onCommonRegister(this, commonRegisterPayload);
+            return;
+        }
+        if (net.neoforged.neoforge.network.registration.NetworkRegistry.isModdedPayload(packet.payload())) {
+            net.neoforged.neoforge.network.registration.NetworkRegistry.handleModdedPayload(this, packet);
+            return;
+        }
+        // Eturlia end - NeoForge network handshake
+
         // Paper start - Brand support
         if (packet.payload() instanceof net.minecraft.network.protocol.common.custom.BrandPayload brandPayload) {
             this.player.clientBrandName = brandPayload.brand();
diff --git a/src/main/java/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java b/src/main/java/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
index fe4678733af1195f1081ec14c08ea733d15ae869..6f0bcd09b400cbf8dfad7883a81e8fd618290922 100644
--- a/src/main/java/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
+++ b/src/main/java/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
@@ -85,6 +85,19 @@ public class ServerConfigurationPacketListenerImpl extends ServerCommonPacketLis
     }
 
     public void startConfiguration() {
+        // Eturlia start - NeoForge handshake: negotiate modded channels before vanilla configuration.
+        // Without this the client sees a plain vanilla server and refuses to join with
+        // "you are trying to connect to a server that is not using NeoForge".
+        this.send(new ClientboundCustomPayloadPacket(new net.neoforged.neoforge.network.payload.MinecraftUnregisterPayload(
+                net.neoforged.neoforge.network.registration.NetworkRegistry.getInitialServerUnregisterChannels())));
+        this.send(new ClientboundCustomPayloadPacket(new net.neoforged.neoforge.network.payload.MinecraftRegisterPayload(
+                net.neoforged.neoforge.network.registration.NetworkRegistry.getInitialListeningChannels(this.flow()))));
+        this.send(new ClientboundCustomPayloadPacket(new net.neoforged.neoforge.network.payload.ModdedNetworkQueryPayload(java.util.Map.of())));
+        this.send(new net.minecraft.network.protocol.common.ClientboundPingPacket(0));
+    }
+
+    /** Vanilla's configuration body; runs once the ping above is answered. */
+    private void eturliaRunConfiguration() {
         this.send(new ClientboundCustomPayloadPacket(new BrandPayload(this.server.getServerModName())));
         ServerLinks serverlinks = this.server.serverLinks();
         // CraftBukkit start
@@ -104,6 +117,7 @@ public class ServerConfigurationPacketListenerImpl extends ServerCommonPacketLis
         }).toList();
 
         this.send(new ClientboundUpdateEnabledFeaturesPacket(FeatureFlags.REGISTRY.toNames(this.server.getWorldData().enabledFeatures())));
+        net.neoforged.neoforge.network.ConfigurationInitialization.configureEarlyTasks(this, this.configurationTasks::add); // Eturlia - NeoForge handshake: sync registries before vanilla tags
         this.synchronizeRegistriesTask = new SynchronizeRegistriesTask(list, layeredregistryaccess);
         this.configurationTasks.add(this.synchronizeRegistriesTask);
         this.addOptionalTasks();
@@ -120,7 +134,40 @@ public class ServerConfigurationPacketListenerImpl extends ServerCommonPacketLis
         this.server.getServerResourcePack().ifPresent((minecraftserver_serverresourcepackinfo) -> {
             this.configurationTasks.add(new ServerResourcePackConfigurationTask(minecraftserver_serverresourcepackinfo));
         });
+        // Eturlia start - NeoForge handshake: let mods contribute configuration tasks
+        this.configurationTasks.addAll(net.neoforged.fml.ModLoader.postEventWithReturn(
+                new net.neoforged.neoforge.network.event.RegisterConfigurationTasksEvent(this)).getConfigurationTasks());
+        // Eturlia end - NeoForge handshake
+    }
+
+    // Eturlia start - NeoForge handshake: negotiation hooks
+    @Override
+    public void handleCustomPayload(net.minecraft.network.protocol.common.ServerboundCustomPayloadPacket packet) {
+        if (packet.payload() instanceof net.neoforged.neoforge.network.payload.ModdedNetworkQueryPayload moddedQuery) {
+            this.eturlia$connectionType = net.neoforged.neoforge.network.connection.ConnectionType.NEOFORGE;
+            net.neoforged.neoforge.network.registration.NetworkRegistry.initializeNeoForgeConnection(this, moddedQuery.queries());
+            return;
+        }
+        super.handleCustomPayload(packet);
+    }
+
+    @Override
+    public void handlePong(net.minecraft.network.protocol.common.ServerboundPongPacket packet) {
+        super.handlePong(packet);
+        // startConfiguration() sends a ping with id 0; the pong tells us the client finished
+        // answering the modded query, so the real configuration can begin.
+        if (packet.getId() == 0) {
+            if (!this.eturlia$connectionType.isNeoForge()
+                    && !net.neoforged.neoforge.network.registration.NetworkRegistry.initializeOtherConnection(this)) {
+                return;
+            }
+            // CraftBukkit fires PlayerLinksSendEvent inside the configuration body and that event
+            // is main-thread only, while handlePong() runs on a network/region thread. Hand the
+            // work to the server task queue (the global region on Folia).
+            this.server.execute(this::eturliaRunConfiguration);
+        }
     }
+    // Eturlia end - NeoForge handshake
 
     @Override
     public void handleClientInformation(ServerboundClientInformationPacket packet) {
