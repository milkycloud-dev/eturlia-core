+    /** Vanilla's configuration body; runs once the ping above is answered. */
+    private void eturliaRunConfiguration() {
         this.send(new ClientboundCustomPayloadPacket(new BrandPayload(this.server.getServerModName())));
         ServerLinks serverlinks = this.server.serverLinks();
         // CraftBukkit start
@@ -104,6 +117,7 @@ public class ServerConfigurationPacketListenerImpl extends ServerCommonPacketLis
