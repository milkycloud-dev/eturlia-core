+    protected static enum TabVisibility {
+        PARENT_AND_SEARCH_TABS,
+        PARENT_TAB_ONLY,
+        SEARCH_TAB_ONLY;
+    }
+
+    public static enum Type {
+        CATEGORY,
+        INVENTORY,
+        HOTBAR,
+        SEARCH;
+    }
+}
