-    private static final Map<Class<?>, ArgumentTypeInfo<?, ?>> BY_CLASS = Maps.newHashMap();
+    // Eturlia: ConcurrentHashMap, not HashMap. Mods register argument types from their own
+    // threads while region threads read this map to serialise commands; a synchronized
+    // writer with unsynchronized readers is a data race on the map's internals.
+    private static final Map<Class<?>, ArgumentTypeInfo<?, ?>> BY_CLASS = new java.util.concurrent.ConcurrentHashMap<>();
 
+    /**
+     * NeoForge: Use with DeferredRegister#register(String, Supplier) to populate BY_CLASS
+     * and register the argument type info for command sync.
+     */
+    public static <A extends ArgumentType<?>, T extends ArgumentTypeInfo.Template<A>, I extends ArgumentTypeInfo<A, T>> I registerByClass(
+        Class<A> infoClass, I argumentTypeInfo
+    ) {
+        BY_CLASS.put(infoClass, argumentTypeInfo);
+        return argumentTypeInfo;
+    }
+
     private static <A extends ArgumentType<?>, T extends ArgumentTypeInfo.Template<A>> ArgumentTypeInfo<A, T> register(
-        Registry<ArgumentTypeInfo<?, ?>> registry, String id, Class<? extends A> clazz, ArgumentTypeInfo<A, T> serializer
+        Registry<ArgumentTypeInfo<?, ?>> registry, String id, Class<?> clazz, ArgumentTypeInfo<A, T> serializer
     ) {
         BY_CLASS.put(clazz, serializer);
         return Registry.register(registry, id, serializer);
