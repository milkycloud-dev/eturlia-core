     // Paper end - adventure; create separate codec for each locale
 
-    private static Codec<Component> createCodec(Codec<Component> selfCodec) {
+    // Eturlia: locale for Paper adventure path, threaded so 1-arg createCodec keeps matcher call site (CreativeCore)
+    private static final ThreadLocal<java.util.Locale> ETURLIA_COMPONENT_LOCALE = new ThreadLocal<>();
+
+    private static Codec<Component> createCodec(Codec<Component> selfCodec, @javax.annotation.Nullable java.util.Locale locale) {
         // Paper start - adventure; create separate codec for each locale
-        return createCodec(selfCodec, null);
+        java.util.Locale prev = ETURLIA_COMPONENT_LOCALE.get();
+        ETURLIA_COMPONENT_LOCALE.set(locale);
+        try {
+            return createCodec(selfCodec);
+        } finally {
+            if (prev != null) {
+                ETURLIA_COMPONENT_LOCALE.set(prev);
+            } else {
+                ETURLIA_COMPONENT_LOCALE.remove();
+            }
+        }
     }
 
-    private static Codec<Component> createCodec(Codec<Component> selfCodec, @javax.annotation.Nullable java.util.Locale locale) {
