From: Eturlia <eturlia@users.noreply.github.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] NeoForge EturliaServer Entry Point

Integrates the Eturlia server entry point with MinecraftServer. This patch
injects NeoForge lifecycle hooks (ServerLifecycleHooks) and Eturlia region-
aware event dispatch into the Folia server bootstrap and tick loop.

Key changes:
- ServerLifecycleHooks.handleServerAboutToStart() called before Folia region init
- ServerLifecycleHooks.handleServerStarting() called before "Done" message
- ServerLifecycleHooks.handleServerStarted() called after "Done" message
- ServerLifecycleHooks.handleServerStopping() called during shutdown
- ServerLifecycleHooks.handleServerStopped() called in stopPart2
- NeoForge EventHooks.fireServerTickPre/Post for server tick events

Lifecycle ordering fixes:
- handleServerStarted() used to sit after Thread.sleep(Long.MAX_VALUE), so
  ServerStartedEvent never fired at all; it now runs right after "Done".
- handleServerStarting() used to sit inside the for(;;) loop and could fire
  repeatedly; it now runs exactly once, before "Done".
- handleServerAboutToStart() now runs before RegionizedServer.init() instead of
  after it, so mod config loading happens before region threading starts.
- The duplicate handleServerStopping() on the safeShutdown path was removed;
  stopServer() already fires ServerStoppingEvent.

diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -48,6 +48,11 @@ import java.util.concurrent.CompletableFuture;
 import java.util.concurrent.Executor;
 import java.util.concurrent.atomic.AtomicReference;
 import java.util.function.BooleanSupplier;
+import net.neoforged.neoforge.event.EventHooks;
+import net.neoforged.neoforge.server.ServerLifecycleHooks;
+import net.neoforged.neoforge.common.NeoForge;
+import net.neoforged.neoforge.event.tick.ServerTickEvent;
+import net.neoforged.neoforge.event.tick.LevelTickEvent;
 import java.util.function.Consumer;
 import java.util.function.Function;
 import java.util.stream.Collectors;
@@ -1063,6 +1068,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
     public void stopServer() {
         // Folia start - region threading
+        ServerLifecycleHooks.handleServerStopping(this); // NeoForge - fire ServerStoppingEvent
         // halt scheduler
         // don't wait, we may be on a scheduler thread
         io.papermc.paper.threadedregions.TickRegions.getScheduler().halt(false, 0L);
@@ -1153,6 +1159,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     }
     public void stopPart2() {
         // Folia end - region threading
+        ServerLifecycleHooks.handleServerStopped(this); // NeoForge - fire ServerStoppedEvent
         this.resources.close();
 
         try {
@@ -1288,11 +1288,14 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             // Folia start - region threading
             if (true) {
+                ServerLifecycleHooks.handleServerAboutToStart(this); // NeoForge - fire ServerAboutToStartEvent (before region init)
                 io.papermc.paper.threadedregions.RegionizedServer.getInstance().init(); // Folia - region threading - only after loading worlds
+                ServerLifecycleHooks.handleServerStarting(this); // NeoForge - fire ServerStartingEvent (once, before Done)
                 String doneTime = String.format(java.util.Locale.ROOT, "%.3fs", (double) (Util.getNanos() - serverStartTime) / 1.0E9D);
                 LOGGER.info("Done ({})! For help, type \"help\"", doneTime);
+                ServerLifecycleHooks.handleServerStarted(this); // NeoForge - fire ServerStartedEvent (once, after Done)
                 for (;;) {
                     try {
                         Thread.sleep(Long.MAX_VALUE);
                     } catch (final InterruptedException ex) {}
                 }
             }
@@ -1672,6 +1682,15 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             return scheduledEnd - System.nanoTime() > targetBuffer;
         };
         this.server.spark.tickStart(); // Paper - spark
+        // NeoForge start - server tick pre event
+        // Eturlia: Folia runs this body once per region, so firing the event here handed every
+        // listener N concurrent invocations per tick. Only the first region to reach a given
+        // tick number fires it, which restores NeoForge's once-per-tick contract. It is still
+        // delivered on a region thread, so listeners must not assume the global thread.
+        if (eturlia$firstTickPre(region.getCurrentTick())) {
+            EventHooks.fireServerTickPre(shouldKeepTicking, this);
+        }
+        // NeoForge end
         new com.destroystokyo.paper.event.server.ServerTickStartEvent((int)region.getCurrentTick()).callEvent(); // Paper
         // Folia end - region threading
         co.aikar.timings.TimingsManager.FULL_SERVER_TICK.startTiming(); // Paper
@@ -1764,6 +1783,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.profiler.pop();
         org.spigotmc.WatchdogThread.tick(); // Spigot
         co.aikar.timings.TimingsManager.FULL_SERVER_TICK.stopTiming(); // Paper
+        // NeoForge start - server tick post event
+        // Eturlia: gated like fireServerTickPre above, on its own counter — one Post per
+        // tick number, possibly from a different region thread than the Pre.
+        if (eturlia$firstTickPost(region.getCurrentTick())) {
+            EventHooks.fireServerTickPost(shouldKeepTicking, this);
+        }
+        // NeoForge end
     }
 
     private void logTickMethodTime(long tickStartTime) {
