-    // Eturlia: Sable player_freezing @Inject TAIL of placeNewPlayer(Connection, ServerPlayer, Cookie).
-    // CraftBukkit added Optional/String/Location — rename that entry so mixin only matches vanilla.
-    public void placeNewPlayer(Connection connection, ServerPlayer player, CommonListenerCookie clientData) {
-    }
+    // Eturlia: Sable UDP injects AFTER first ServerGamePacketListenerImpl.send inside placeNewPlayer(3-arg).
+    // Paper extras (Optional/String/Location) arrive via ThreadLocal from placeNewPlayerWithSpawn.
+    public static final ThreadLocal<Object[]> ETURLIA$PLACE_NEW_PLAYER_EXTRAS = new ThreadLocal<>();
 
     public void placeNewPlayerWithSpawn(Connection connection, ServerPlayer player, CommonListenerCookie clientData, Optional<CompoundTag> optional, String s, Location selectedSpawn) {
+        ETURLIA$PLACE_NEW_PLAYER_EXTRAS.set(new Object[]{optional, s, selectedSpawn});
+        try {
+            this.placeNewPlayer(connection, player, clientData);
+        } finally {
+            ETURLIA$PLACE_NEW_PLAYER_EXTRAS.remove();
+        }
+    }
+
+    public void placeNewPlayer(Connection connection, ServerPlayer player, CommonListenerCookie clientData) {
+        Object[] extras = ETURLIA$PLACE_NEW_PLAYER_EXTRAS.get();
+        if (extras == null) {
+            return;
+        }
+        @SuppressWarnings("unchecked")
+        Optional<CompoundTag> optional = (Optional<CompoundTag>) extras[0];
+        String s = (String) extras[1];
+        Location selectedSpawn = (Location) extras[2];
+        // body continues (was placeNewPlayerWithSpawn / placeNewPlayerBody)
         ServerLevel worldserver1 = ((CraftWorld)selectedSpawn.getWorld()).getHandle();
         player.setPosRaw(selectedSpawn.getX(), selectedSpawn.getY(), selectedSpawn.getZ());
         player.lastSave = System.nanoTime(); // changed to nanoTime
@@ -519,7 +536,7 @@ public abstract class PlayerList {
