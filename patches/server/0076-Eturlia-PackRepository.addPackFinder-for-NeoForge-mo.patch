From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 7 Aug 2026 06:21:04 +0000
Subject: [PATCH] Eturlia: PackRepository.addPackFinder for NeoForge mod
 datapacks

ResourcePackLoader.populatePackRepository requires a mutable sources set
and addPackFinder(); without it boot fails with NoSuchMethodError.

diff --git a/src/main/java/net/minecraft/server/packs/repository/PackRepository.java b/src/main/java/net/minecraft/server/packs/repository/PackRepository.java
index 7cae8350023fb138bfcc5af28af6d36a3433d063..99a3a04de15112e2515c4a1ef9bcb00dc1b6c226 100644
--- a/src/main/java/net/minecraft/server/packs/repository/PackRepository.java
+++ b/src/main/java/net/minecraft/server/packs/repository/PackRepository.java
@@ -23,7 +23,8 @@ public class PackRepository {
     private List<Pack> selected = ImmutableList.of();
 
     public PackRepository(RepositorySource... providers) {
-        this.sources = ImmutableSet.copyOf(providers);
+        // NeoForge: mutable so ResourcePackLoader.populatePackRepository can addPackFinder
+        this.sources = new java.util.LinkedHashSet<>(List.of(providers));
     }
 
     public static String displayPackList(Collection<Pack> profiles) {
@@ -117,6 +118,11 @@ public class PackRepository {
         return this.available.get(id);
     }
 
+    // NeoForge: ResourcePackLoader.populatePackRepository registers mod jar datapacks
+    public synchronized void addPackFinder(RepositorySource packFinder) {
+        this.sources.add(packFinder);
+    }
+
     public boolean isAvailable(String id) {
         return this.available.containsKey(id);
     }
