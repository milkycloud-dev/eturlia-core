+++ b/src/main/java/net/minecraft/world/entity/Entity.java
@@ -5231,81 +5231,105 @@ public abstract class Entity extends net.neoforged.neoforge.attachment.Attachmen
         return Mth.lerp(delta, this.yRotO, this.yRot);
     }
 
+    // Eturlia/NeoForge: TagKey overload delegates to no-arg FluidType path (Sable @Overwrite).
