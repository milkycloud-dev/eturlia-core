+    public final boolean isInFluidType(net.neoforged.neoforge.fluids.FluidType type) {
+        return this.getFluidTypeHeight(type) > 0.0D;
+    }
+
     public final net.neoforged.neoforge.fluids.FluidType getEyeInFluidType() {
         return this.forgeFluidTypeOnEyes;
