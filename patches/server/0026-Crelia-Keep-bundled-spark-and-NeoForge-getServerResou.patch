From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Crelia <crelia@users.noreply.github.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] Crelia Keep bundled spark and NeoForge getServerResources

Folia 0018 disables Paper's embedded spark (not region-thread-safe upstream).
Crelia's fat standalone ships spark-api/spark-paper and expects the bundled
profiler to work when paper-global.yml has spark.enabled=true.

Also expose MinecraftServer.getServerResources() for NeoForge LanguageHook
(Folia/Paper only publish the public `resources` field).

diff --git a/src/main/java/io/papermc/paper/SparksFly.java b/src/main/java/io/papermc/paper/SparksFly.java
index 4b30b05dcd99176715d49133fb99b96383a0ecbc..aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 100644
--- a/src/main/java/io/papermc/paper/SparksFly.java
+++ b/src/main/java/io/papermc/paper/SparksFly.java
@@ -109,7 +109,9 @@ public final class SparksFly {
 
     private void enable() {
         if (!this.enabled) {
-            if (false) { // Folia - disable in-built spark profiler
+            // Crelia: keep Paper's bundled spark available (Folia 0018 had forced it off).
+            // Spark jars stay on the fat classpath; respect paper-global.yml spark.enabled.
+            if (GlobalConfiguration.get().spark.enabled) {
                 this.enabled = true;
                 this.spark.enable();
             } else {
@@ -161,7 +163,8 @@ public final class SparksFly {
     }
 
     public static boolean isPluginPreferred() {
-        return true; // Folia - disable in-built spark profiler
+        // Crelia: restore Paper preference flag (Folia 0018 forced plugin-only / disabled bundled spark).
+        return Boolean.getBoolean(PREFER_SPARK_PLUGIN_PROPERTY);
     }
 
     private static boolean isPluginEnabled(final Server server) {
diff --git a/src/main/java/net/minecraft/server/MinecraftServer.java b/src/main/java/net/minecraft/server/MinecraftServer.java
index 4b35c256ea3e6cf5405b950886ef621b4185dffb..bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb 100644
--- a/src/main/java/net/minecraft/server/MinecraftServer.java
+++ b/src/main/java/net/minecraft/server/MinecraftServer.java
@@ -3067,6 +3067,12 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     public ResourceManager getResourceManager() {
         return this.resources.resourceManager;
     }
 
+    // NeoForge LanguageHook / lifecycle expect this accessor (Mojang mapping name).
+    public MinecraftServer.ReloadableResources getServerResources() {
+        return this.resources;
+    }
+
     public boolean isCurrentlySaving() {
         return this.isSaving;
     }
