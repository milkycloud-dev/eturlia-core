From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Crelia <crelia@users.noreply.github.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] Crelia Call ServerModLoader before Folia Main

NeoForge loads mods from LoadingModList via ServerModLoader.load() early
in net.minecraft.server.Main. Folia enters through PaperBootstrap instead,
so invoke ServerModLoader here after ModLauncher has completed the FML scan.

diff --git a/src/main/java/io/papermc/paper/PaperBootstrap.java b/src/main/java/io/papermc/paper/PaperBootstrap.java
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111 100644
--- a/src/main/java/io/papermc/paper/PaperBootstrap.java
+++ b/src/main/java/io/papermc/paper/PaperBootstrap.java
@@ -17,6 +17,22 @@ public final class PaperBootstrap {
         SharedConstants.tryDetectVersion();
 
         getStartupVersionMessages().forEach(LOGGER::info);
 
+        // NeoForge: construct ModList / fire load events once ModLauncher has scanned mods/
+        try {
+            Class.forName("net.neoforged.neoforge.server.loading.ServerModLoader")
+                    .getMethod("load")
+                    .invoke(null);
+            LOGGER.info("NeoForge ServerModLoader.load() completed");
+        } catch (ClassNotFoundException e) {
+            LOGGER.warn("ServerModLoader not on classpath — NeoForge mods will not initialize");
+        } catch (ReflectiveOperationException e) {
+            Throwable cause = e.getCause() != null ? e.getCause() : e;
+            LOGGER.error("NeoForge ServerModLoader.load() failed", cause);
+            throw new RuntimeException("NeoForge mod loading failed", cause);
+        }
+
         Main.main(options);
     }
