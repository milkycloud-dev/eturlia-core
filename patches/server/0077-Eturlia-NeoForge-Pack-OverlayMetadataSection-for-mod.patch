From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 7 Aug 2026 06:28:39 +0000
Subject: [PATCH] Eturlia: NeoForge Pack/OverlayMetadataSection for mod
 datapacks

ResourcePackLoader needs OverlayMetadataSection.NEOFORGE_TYPE plus Pack
hidden/children APIs, and PackRepository must expand child packs when
discovering/selecting so mod jar datapacks load correctly.

diff --git a/src/main/java/net/minecraft/server/packs/OverlayMetadataSection.java b/src/main/java/net/minecraft/server/packs/OverlayMetadataSection.java
index edc35301b91c45bf92ea34364648d7bbfa8b49c1..75068411ed82f7b7e3fa32682ded55eaab511c49 100644
--- a/src/main/java/net/minecraft/server/packs/OverlayMetadataSection.java
+++ b/src/main/java/net/minecraft/server/packs/OverlayMetadataSection.java
@@ -15,6 +15,8 @@ public record OverlayMetadataSection(List<OverlayMetadataSection.OverlayEntry> o
                 .apply(instance, OverlayMetadataSection::new)
     );
     public static final MetadataSectionType<OverlayMetadataSection> TYPE = MetadataSectionType.fromCodec("overlays", CODEC);
+    // NeoForge: alternate overlays section loaded only on NeoForge (ResourcePackLoader / Pack.readPackMetadata)
+    public static final MetadataSectionType<OverlayMetadataSection> NEOFORGE_TYPE = MetadataSectionType.fromCodec("neoforge:overlays", CODEC);
 
     private static DataResult<String> validateOverlayDir(String directoryName) {
         return !DIR_VALIDATOR.matcher(directoryName).matches()
