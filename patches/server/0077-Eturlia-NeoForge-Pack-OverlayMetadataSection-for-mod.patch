+            this.getAvailablePacks(enabledNames), this.available.values()
+        );
 
         for (Pack pack : this.available.values()) {
             if (pack.isRequired() && !list.contains(pack)) {
-                pack.getDefaultPosition().insert(list, pack, Pack::selectionConfig, false);
