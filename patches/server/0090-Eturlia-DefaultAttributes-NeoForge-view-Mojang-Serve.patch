-    // Add env and gen to constructor, IWorldDataServer -> WorldDataServer
-    public ServerLevel(MinecraftServer minecraftserver, Executor executor, LevelStorageSource.LevelStorageAccess convertable_conversionsession, PrimaryLevelData iworlddataserver, ResourceKey<Level> resourcekey, LevelStem worlddimension, ChunkProgressListener worldloadlistener, boolean flag, long i, List<CustomSpawner> list, boolean flag1, @Nullable RandomSequences randomsequences, org.bukkit.World.Environment env, org.bukkit.generator.ChunkGenerator gen, org.bukkit.generator.BiomeProvider biomeProvider) {
+
+    // Eturlia: unwrap Moonlight ReadOlyServerLevelData / ensure PrimaryLevelData for CB ctor path
+    private static PrimaryLevelData eturliaUnwrapPrimary(ServerLevelData data) {
+        if (data instanceof PrimaryLevelData primary) {
+            return primary;
+        }
+        try {
+            java.lang.reflect.Field wrapped = data.getClass().getField("wrapped");
+            Object inner = wrapped.get(data);
+            if (inner instanceof PrimaryLevelData primary) {
+                return primary;
+            }
+        } catch (ReflectiveOperationException ignored) {
+        }
+        throw new IllegalArgumentException("Eturlia: cannot unwrap PrimaryLevelData from " + data.getClass().getName());
+    }
+
+    // Eturlia: Mojang-shaped ctor for Moonlight FakeServerLevel (ServerLevelData + no Bukkit extras)
+    public ServerLevel(MinecraftServer minecraftserver, Executor executor, LevelStorageSource.LevelStorageAccess convertable_conversionsession, ServerLevelData iworlddataserver, ResourceKey<Level> resourcekey, LevelStem worlddimension, ChunkProgressListener worldloadlistener, boolean flag, long i, List<CustomSpawner> list, boolean flag1, @Nullable RandomSequences randomsequences) {
+        this(minecraftserver, executor, convertable_conversionsession, iworlddataserver, resourcekey, worlddimension, worldloadlistener, flag, i, list, flag1, randomsequences, org.bukkit.World.Environment.NORMAL, null, null);
+    }
+
+    // CraftBukkit: env/gen extras. Eturlia: ServerLevelData (not PrimaryLevelData) so FakeServerLevel ReadOly wrapper works.
