+    public static AttributeSupplier getSupplier(EntityType<? extends LivingEntity> type) {
+        // Eturlia/NeoForge: mod attributes from EntityAttributeCreationEvent
+        AttributeSupplier supplier = net.neoforged.neoforge.common.CommonHooks.getAttributesView().get(type);
+        return supplier != null ? supplier : SUPPLIERS.get(type);
+    }
+
+    public static boolean hasSupplier(EntityType<?> type) {
+        return SUPPLIERS.containsKey(type) || net.neoforged.neoforge.common.CommonHooks.getAttributesView().containsKey(type);
+    }
+
+    public static void validate() {
+        BuiltInRegistries.ENTITY_TYPE
+            .stream()
+            .filter(entityType -> entityType.getCategory() != MobCategory.MISC)
+            .filter(entityType -> !hasSupplier((EntityType<?>)entityType))
+            .map(BuiltInRegistries.ENTITY_TYPE::getKey)
+            .forEach(id -> Util.logAndPauseIfInIde("Entity " + id + " has no attributes"));
+    }
