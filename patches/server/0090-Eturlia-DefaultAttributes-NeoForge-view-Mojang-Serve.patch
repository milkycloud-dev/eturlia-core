 import net.minecraft.world.phys.shapes.BooleanOp;
@@ -201,9 +202,21 @@ public class ServerLevel extends Level implements WorldGenLevel, ca.spottedleaf.
     private final MinecraftServer server;
     // Eturlia: Mojang ServerLevelData field descriptor for Moonlight FakeServerLevel getfield
     // (CraftBukkit had PrimaryLevelData which breaks NeoForge mods' binary field access)
-    public final net.minecraft.world.level.storage.ServerLevelData serverLevelData;
+    public final ServerLevelData serverLevelData;
     public PrimaryLevelData eturliaPrimaryLevelData() {
-        return (PrimaryLevelData) this.serverLevelData;
+        if (this.serverLevelData instanceof PrimaryLevelData primary) {
+            return primary;
+        }
+        // Moonlight FakeServerLevel$ReadOlyServerLevelData.wrapped
+        try {
+            java.lang.reflect.Field wrapped = this.serverLevelData.getClass().getField("wrapped");
+            Object inner = wrapped.get(this.serverLevelData);
+            if (inner instanceof PrimaryLevelData primary) {
+                return primary;
+            }
+        } catch (ReflectiveOperationException ignored) {
+        }
+        throw new IllegalStateException("Eturlia: serverLevelData is not PrimaryLevelData: " + this.serverLevelData.getClass().getName());
     }
     private int lastSpawnChunkRadius;
     // Folia: real tick list lives in RegionizedWorldData. Facade keeps NeoForge/Create field access working.
@@ -609,14 +622,36 @@ public class ServerLevel extends Level implements WorldGenLevel, ca.spottedleaf.
     }
     // Folia end - region threading
 
-    // Add env and gen to constructor, IWorldDataServer -> WorldDataServer
-    public ServerLevel(MinecraftServer minecraftserver, Executor executor, LevelStorageSource.LevelStorageAccess convertable_conversionsession, PrimaryLevelData iworlddataserver, ResourceKey<Level> resourcekey, LevelStem worlddimension, ChunkProgressListener worldloadlistener, boolean flag, long i, List<CustomSpawner> list, boolean flag1, @Nullable RandomSequences randomsequences, org.bukkit.World.Environment env, org.bukkit.generator.ChunkGenerator gen, org.bukkit.generator.BiomeProvider biomeProvider) {
+
+    // Eturlia: unwrap Moonlight ReadOlyServerLevelData / ensure PrimaryLevelData for CB ctor path
+    private static PrimaryLevelData eturliaUnwrapPrimary(ServerLevelData data) {
+        if (data instanceof PrimaryLevelData primary) {
+            return primary;
+        }
+        try {
+            java.lang.reflect.Field wrapped = data.getClass().getField("wrapped");
+            Object inner = wrapped.get(data);
+            if (inner instanceof PrimaryLevelData primary) {
+                return primary;
+            }
+        } catch (ReflectiveOperationException ignored) {
+        }
+        throw new IllegalArgumentException("Eturlia: cannot unwrap PrimaryLevelData from " + data.getClass().getName());
+    }
+
+    // Eturlia: Mojang-shaped ctor for Moonlight FakeServerLevel (ServerLevelData + no Bukkit extras)
+    public ServerLevel(MinecraftServer minecraftserver, Executor executor, LevelStorageSource.LevelStorageAccess convertable_conversionsession, ServerLevelData iworlddataserver, ResourceKey<Level> resourcekey, LevelStem worlddimension, ChunkProgressListener worldloadlistener, boolean flag, long i, List<CustomSpawner> list, boolean flag1, @Nullable RandomSequences randomsequences) {
+        this(minecraftserver, executor, convertable_conversionsession, iworlddataserver, resourcekey, worlddimension, worldloadlistener, flag, i, list, flag1, randomsequences, org.bukkit.World.Environment.NORMAL, null, null);
+    }
+
+    // CraftBukkit: env/gen extras. Eturlia: ServerLevelData (not PrimaryLevelData) so FakeServerLevel ReadOly wrapper works.
+    public ServerLevel(MinecraftServer minecraftserver, Executor executor, LevelStorageSource.LevelStorageAccess convertable_conversionsession, ServerLevelData iworlddataserver, ResourceKey<Level> resourcekey, LevelStem worlddimension, ChunkProgressListener worldloadlistener, boolean flag, long i, List<CustomSpawner> list, boolean flag1, @Nullable RandomSequences randomsequences, org.bukkit.World.Environment env, org.bukkit.generator.ChunkGenerator gen, org.bukkit.generator.BiomeProvider biomeProvider) {
         // IRegistryCustom.Dimension iregistrycustom_dimension = minecraftserver.registryAccess(); // CraftBukkit - decompile error
         // Holder holder = worlddimension.type(); // CraftBukkit - decompile error
 
         // Objects.requireNonNull(minecraftserver); // CraftBukkit - decompile error
         // Eturlia: ThreadLocal extras must be set in an expression evaluated before super() (super must be first stmt).
-        super(Level.eturliaPushLevelCtorExtras(iworlddataserver, new Level.EturliaLevelCtorExtras(gen, biomeProvider, env, spigotConfig -> minecraftserver.paperConfigurations.createWorldConfig(io.papermc.paper.configuration.PaperConfigurations.createWorldContextMap(convertable_conversionsession.levelDirectory.path(), iworlddataserver.getLevelName(), resourcekey.location(), spigotConfig, minecraftserver.registryAccess(), iworlddataserver.getGameRules())), executor)), resourcekey, minecraftserver.registryAccess(), worlddimension.type(), minecraftserver::getProfiler, false, flag, i, minecraftserver.getMaxChainedNeighborUpdates());
+        super(Level.eturliaPushLevelCtorExtras(iworlddataserver, new Level.EturliaLevelCtorExtras(gen, biomeProvider, env, spigotConfig -> minecraftserver.paperConfigurations.createWorldConfig(io.papermc.paper.configuration.PaperConfigurations.createWorldContextMap(convertable_conversionsession.levelDirectory.path(), iworlddataserver.getLevelName(), resourcekey.location(), spigotConfig, minecraftserver.registryAccess(), eturliaUnwrapPrimary(iworlddataserver).getGameRules())), executor)), resourcekey, minecraftserver.registryAccess(), worlddimension.type(), minecraftserver::getProfiler, false, flag, i, minecraftserver.getMaxChainedNeighborUpdates());
         Level.ETURLIA$LEVEL_CTOR_EXTRAS.remove();
         this.pvpMode = minecraftserver.isPvpAllowed();
         this.convertable = convertable_conversionsession;
diff --git a/src/main/java/net/minecraft/world/entity/ai/attributes/DefaultAttributes.java b/src/main/java/net/minecraft/world/entity/ai/attributes/DefaultAttributes.java
