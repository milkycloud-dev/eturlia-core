From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 6 Aug 2026 21:38:22 +0000
Subject: [PATCH] Eturlia: restore Entity.position() in
 TrackedEntity.updatePlayer for Sable

Sable TrackedEntityMixin redirects a single Entity.position() in
updatePlayer for sublevel tracking. Paper removed both position()
calls; restore one on the tracked entity while keeping scalar math.

diff --git a/src/main/java/net/minecraft/server/level/ChunkMap.java b/src/main/java/net/minecraft/server/level/ChunkMap.java
--- a/src/main/java/net/minecraft/server/level/ChunkMap.java
+++ b/src/main/java/net/minecraft/server/level/ChunkMap.java
@@ -1210,11 +1210,14 @@ public class ChunkMap extends ChunkStorage implements ChunkHolder.PlayerProvider
         public void updatePlayer(ServerPlayer player) {
             org.spigotmc.AsyncCatcher.catchOp("player tracker update"); // Spigot
             if (player != this.entity) {
-                // Paper start - remove allocation of Vec3D here
-                // Vec3 vec3d = player.position().subtract(this.entity.position());
-                double vec3d_dx = player.getX() - this.entity.getX();
-                double vec3d_dz = player.getZ() - this.entity.getZ();
-                // Paper end - remove allocation of Vec3D here
+                // Eturlia: keep a single Entity.position() INVOKE for Sable TrackedEntityMixin
+                // @Redirect (sable$trackSubLevelEntities). Paper avoided Vec3.subtract allocation;
+                // use position() once for the tracked entity, then scalar math for the player.
+                // Vanilla was: player.position().subtract(this.entity.position()) — two INVOKEs;
+                // Sable requires exactly one Entity.position() in updatePlayer.
+                net.minecraft.world.phys.Vec3 entityPos = this.entity.position();
+                double vec3d_dx = player.getX() - entityPos.x;
+                double vec3d_dz = player.getZ() - entityPos.z;
                 int i = ChunkMap.this.getPlayerViewDistance(player);
                 double d0 = (double) Math.min(this.getEffectiveRange(), i * 16);
                 double d1 = vec3d_dx * vec3d_dx + vec3d_dz * vec3d_dz; // Paper
@@ -1224,7 +1227,7 @@ public class ChunkMap extends ChunkStorage implements ChunkHolder.PlayerProvider
                 if (flag && level.paperConfig().entities.trackingRangeY.enabled) {
                     double rangeY = level.paperConfig().entities.trackingRangeY.get(this.entity, -1);
                     if (rangeY != -1) {
-                        double vec3d_dy = player.getY() - this.entity.getY();
+                        double vec3d_dy = player.getY() - entityPos.y;
                         flag = vec3d_dy * vec3d_dy <= rangeY * rangeY;
                     }
                 }
