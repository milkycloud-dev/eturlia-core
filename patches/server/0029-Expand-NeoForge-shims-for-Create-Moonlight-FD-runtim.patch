From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 6 Aug 2026 14:18:16 +0000
Subject: [PATCH] Expand NeoForge shims for Create/Moonlight/FD runtime gaps

Un-final Vec3i equals/hashCode and ServerLevel.isAreaLoaded for Create
overrides; restore FireBlock.checkBurnOut with NeoForge Direction API for
Moonlight; add ShapedRecipePattern.setCraftingSize, RecipeType.simple,
EntityType.Builder tracking aliases, Item.modifyDefaultComponentsFrom,
RegistryOps copy ctor, and BlockState IBlockStateExtension.

diff --git a/src/main/java/net/minecraft/core/Vec3i.java b/src/main/java/net/minecraft/core/Vec3i.java
--- a/src/main/java/net/minecraft/core/Vec3i.java
+++ b/src/main/java/net/minecraft/core/Vec3i.java
@@ -41,12 +41,14 @@ public class Vec3i implements Comparable<Vec3i> {
     }
 
     @Override
-    public final boolean equals(Object object) { // Paper - Perf: Final for inline
+    // Eturlia/NeoForge: Create TrackNodeLocation overrides equals — cannot be final (Paper inlined it)
+    public boolean equals(Object object) {
         return this == object || object instanceof Vec3i vec3i && this.getX() == vec3i.getX() && this.getY() == vec3i.getY() && this.getZ() == vec3i.getZ();
     }
 
     @Override
-    public final int hashCode() { // Paper - Perf: Final for inline
+    // Eturlia/NeoForge: keep hashCode overridable with equals
+    public int hashCode() {
         return (this.getY() + this.getZ() * 31) * 31 + this.getX();
     }
 
