@@ -878,6 +878,20 @@ public class EntityType<T extends Entity> implements FeatureElement, EntityTypeT
             return this;
         }
 
+        // NeoForge aliases used by Create / content mods
+        public EntityType.Builder<T> setTrackingRange(int range) {
+            return this.clientTrackingRange(range);
+        }
+
+        public EntityType.Builder<T> setUpdateInterval(int interval) {
+            return this.updateInterval(interval);
+        }
+
+        public EntityType.Builder<T> setShouldReceiveVelocityUpdates(boolean value) {
+            // Vanilla has no builder flag; Create only needs the method to exist.
+            return this;
+        }
