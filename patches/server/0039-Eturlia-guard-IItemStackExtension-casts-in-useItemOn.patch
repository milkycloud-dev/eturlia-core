From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 6 Aug 2026 18:32:12 +0000
Subject: [PATCH] Eturlia: guard IItemStackExtension casts in useItemOn

Folia ItemStack is not NeoForge interface-injected; blind casts threw
ClassCastException and broke all block placement (UseItemOn).

diff --git a/src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java b/src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java
index a35c10ee44481a6a74256af30ec99a69e7da65e8..5ae9d872f649d9e9065730193ebe3368ece53c14 100644
--- a/src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java
+++ b/src/main/java/net/minecraft/server/level/ServerPlayerGameMode.java
@@ -603,21 +603,28 @@ public class ServerPlayerGameMode {
                 return InteractionResult.PASS;
             }
         } else {
-            // NeoForge/Eturlia — onItemUseFirst before block/item use
+            // NeoForge/Eturlia — onItemUseFirst before block/item use.
+            // Folia ItemStack is not NeoForge interface-injected; only call when present
+            // (blind cast ClassCastException breaks all block placement).
             UseOnContext useoncontext = new UseOnContext(player, hand, hitResult);
-            if (neoRightClick.getUseItem() != net.neoforged.neoforge.common.util.TriState.FALSE) {
-                InteractionResult first = ((net.neoforged.neoforge.common.extensions.IItemStackExtension) (Object) stack)
-                        .onItemUseFirst(useoncontext);
+            if (neoRightClick.getUseItem() != net.neoforged.neoforge.common.util.TriState.FALSE
+                    && stack instanceof net.neoforged.neoforge.common.extensions.IItemStackExtension ext) {
+                InteractionResult first = ext.onItemUseFirst(useoncontext);
                 if (first != InteractionResult.PASS) {
                     return first;
                 }
             }
             boolean flag = !player.getMainHandItem().isEmpty() || !player.getOffhandItem().isEmpty();
-            boolean flag1 = (player.isSecondaryUseActive() && flag)
-                    && !(((net.neoforged.neoforge.common.extensions.IItemStackExtension) (Object) player.getMainHandItem())
-                    .doesSneakBypassUse(world, blockposition, player)
-                    && ((net.neoforged.neoforge.common.extensions.IItemStackExtension) (Object) player.getOffhandItem())
-                    .doesSneakBypassUse(world, blockposition, player));
+            boolean sneakBypass = false;
+            if (player.getMainHandItem() instanceof net.neoforged.neoforge.common.extensions.IItemStackExtension mainExt
+                    && player.getOffhandItem() instanceof net.neoforged.neoforge.common.extensions.IItemStackExtension offExt) {
+                sneakBypass = mainExt.doesSneakBypassUse(world, blockposition, player)
+                        && offExt.doesSneakBypassUse(world, blockposition, player);
+            } else {
+                // Match NeoForge default: empty stacks bypass sneak-block use
+                sneakBypass = player.getMainHandItem().isEmpty() && player.getOffhandItem().isEmpty();
+            }
+            boolean flag1 = (player.isSecondaryUseActive() && flag) && !sneakBypass;
             ItemStack itemstack1 = stack.copy();
             InteractionResult enuminteractionresult;
 
