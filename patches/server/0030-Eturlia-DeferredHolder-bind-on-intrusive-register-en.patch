From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 6 Aug 2026 14:46:53 +0000
Subject: [PATCH] Eturlia: DeferredHolder bind on intrusive register +
 entity-section bridge

Bind intrusive holder values immediately during MappedRegistry.register so
Create DeferredHolders resolve in RegisterEvent. Reintroduce
PersistentEntitySectionManager construction in ServerLevel.<init> as a
Moonlight FakeServerLevel mixin target (Folia still ticks via moonrise).

diff --git a/src/main/java/net/minecraft/core/MappedRegistry.java b/src/main/java/net/minecraft/core/MappedRegistry.java
index f830120d3c3be8f8715dd9a6c9afeee503b7144a..6ad4330c521f429d165043da4a58544313d281f5 100644
--- a/src/main/java/net/minecraft/core/MappedRegistry.java
+++ b/src/main/java/net/minecraft/core/MappedRegistry.java
@@ -146,9 +146,11 @@ public class MappedRegistry<T> extends net.neoforged.neoforge.registries.BaseMap
             }
 
             reference.bindKey(key);
+            // Eturlia/Neo: bind immediately so DeferredHolders can resolve during RegisterEvent (Create etc.)
+            reference.bindValue(value);
         } else {
             reference = this.byKey.computeIfAbsent(key, k -> Holder.Reference.createStandAlone(this.holderOwner(), (ResourceKey<T>)k));
-            // Neo: bind immediately so DeferredHolders resolve while the registry is unfrozen
+            // Neo: bind immediately so DeferredHolders resolve while the registry is not frozen
             reference.bindValue(value);
         }
 
diff --git a/src/main/java/net/minecraft/server/level/ServerLevel.java b/src/main/java/net/minecraft/server/level/ServerLevel.java
index 102400c478b813258809e28c5629fcd3928b44e6..ed2c93bc2947fddae222c9599a45494ef3bcc2c7 100644
--- a/src/main/java/net/minecraft/server/level/ServerLevel.java
+++ b/src/main/java/net/minecraft/server/level/ServerLevel.java
@@ -223,6 +223,9 @@ public class ServerLevel extends Level implements WorldGenLevel, ca.spottedleaf.
             ServerLevel.this.getCurrentWorldData().forEachTickingEntity(action);
         }
     };
+    // Eturlia: constructed in ctor for Moonlight FakeServerLevel mixin (NEW PersistentEntitySectionManager);
+    // Folia does not tick through this — moonrise ServerEntityLookup is authoritative.
+    private PersistentEntitySectionManager<Entity> entityManager;
     // Paper - rewrite chunk system
     private final GameEventDispatcher gameEventDispatcher;
     public boolean noSave;
@@ -646,6 +649,10 @@ public class ServerLevel extends Level implements WorldGenLevel, ca.spottedleaf.
         DataFixer datafixer = minecraftserver.getFixerUpper();
         EntityPersistentStorage<Entity> entitypersistentstorage = new EntityStorage(new SimpleRegionStorage(new RegionStorageInfo(convertable_conversionsession.getLevelId(), resourcekey, "entities"), convertable_conversionsession.getDimensionPath(resourcekey).resolve("entities"), datafixer, flag2, DataFixTypes.ENTITY_CHUNK), this, minecraftserver);
 
+        // Eturlia: keep NEW PersistentEntitySectionManager in <init> for Moonlight WrapOperation (FakeServerLevel).
+        // Not used for Folia entity ticking (moonrise ServerEntityLookup below).
+        this.entityManager = new PersistentEntitySectionManager<>(Entity.class, new EntityCallbacks(), entitypersistentstorage);
+
         // Paper - rewrite chunk system
         StructureTemplateManager structuretemplatemanager = minecraftserver.getStructureManager();
         int j = this.spigotConfig.viewDistance; // Spigot
