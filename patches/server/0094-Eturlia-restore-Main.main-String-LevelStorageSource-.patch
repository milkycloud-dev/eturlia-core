From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EturliaAgent <agent@eturlia.local>
Date: Fri, 7 Aug 2026 15:39:38 +0000
Subject: [PATCH] Eturlia: restore Main.main(String[]) + LevelStorageSource
 1-arg for libjf/WorldWeaver

Paper boots via OptionSet; NeoForge mods inject into Mojang main(String[]) and
validateAndCreateAccess(String). Bridge OptionSet through ThreadLocal and keep
MinecraftServer.spin inside the String[] body for libjf INVOKE_ASSIGN.

diff --git a/src/main/java/net/minecraft/server/Main.java b/src/main/java/net/minecraft/server/Main.java
--- a/src/main/java/net/minecraft/server/Main.java
+++ b/src/main/java/net/minecraft/server/Main.java
@@ -73,10 +73,41 @@ public class Main {
 
     private static final Logger LOGGER = LogUtils.getLogger();
 
+    /**
+     * Eturlia: Paper boots via {@link #main(OptionSet)}, but NeoForge mods (libjf, WorldWeaver/BetterEnd)
+     * inject into Mojang {@code main([Ljava/lang/String;)V}. Stash the OptionSet so the String[] entry
+     * can run the real body (must still contain {@code MinecraftServer.spin} for libjf INVOKE_ASSIGN).
+     */
+    private static final ThreadLocal<OptionSet> ETURLIA$OPTION_SET = new ThreadLocal<>();
+
+    /**
+     * Eturlia: {@link #main(String[])} is public and Mojang-shaped, so a mod can call it.
+     * Running the boot body twice would start a second server against the same world.
+     */
+    private static final java.util.concurrent.atomic.AtomicBoolean ETURLIA$BOOTED =
+            new java.util.concurrent.atomic.AtomicBoolean();
+
     public Main() {}
 
     @DontObfuscate
-    public static void main(final OptionSet optionset) { // CraftBukkit - replaces main(String[] astring)
+    public static void main(final OptionSet optionset) { // CraftBukkit / Paper entry
+        ETURLIA$OPTION_SET.set(optionset);
+        try {
+            main(new String[0]); // Eturlia: Mojang-shaped entry for mod mixins
+        } finally {
+            ETURLIA$OPTION_SET.remove();
+        }
+    }
+
+    @DontObfuscate
+    public static void main(final String[] astring) { // Eturlia: restore Mojang signature for libjf/WorldWeaver
+        OptionSet optionset = ETURLIA$OPTION_SET.get();
+        if (optionset == null) {
+            throw new IllegalStateException("Eturlia: Main.main(String[]) requires OptionSet from PaperBootstrap");
+        }
+        if (!ETURLIA$BOOTED.compareAndSet(false, true)) {
+            throw new IllegalStateException("Eturlia: Main.main(String[]) re-entered — the server boot body must run exactly once");
+        }
         io.papermc.paper.util.LogManagerShutdownThread.hook(); // Paper
         SharedConstants.tryDetectVersion();
         /* CraftBukkit start - Replace everything
@@ -209,7 +230,8 @@ public class Main {
             // CraftBukkit start
             String s = (String) Optional.ofNullable((String) optionset.valueOf("world")).orElse(dedicatedserversettings.getProperties().levelName);
             LevelStorageSource convertable = LevelStorageSource.createDefault(file.toPath());
-            LevelStorageSource.LevelStorageAccess convertable_conversionsession = convertable.validateAndCreateAccess(s, LevelStem.OVERWORLD);
+            // Eturlia: Mojang 1-arg call site for WorldWeaver/BetterEnd @ModifyExpressionValue
+            LevelStorageSource.LevelStorageAccess convertable_conversionsession = convertable.validateAndCreateAccess(s);
             // CraftBukkit end
             Dynamic dynamic;
 
diff --git a/src/main/java/net/minecraft/world/level/storage/LevelStorageSource.java b/src/main/java/net/minecraft/world/level/storage/LevelStorageSource.java
--- a/src/main/java/net/minecraft/world/level/storage/LevelStorageSource.java
+++ b/src/main/java/net/minecraft/world/level/storage/LevelStorageSource.java
@@ -418,6 +418,11 @@ public class LevelStorageSource {
         return this.backupDir;
     }
 
+    // Eturlia: Mojang 1-arg overload for WorldWeaver/BetterEnd mixin anchors
+    public LevelStorageSource.LevelStorageAccess validateAndCreateAccess(String s) throws IOException, ContentValidationException {
+        return this.validateAndCreateAccess(s, LevelStem.OVERWORLD);
+    }
+
     public LevelStorageSource.LevelStorageAccess validateAndCreateAccess(String s, ResourceKey<LevelStem> dimensionType) throws IOException, ContentValidationException { // CraftBukkit
         Path path = this.getLevelPath(s);
         List<ForbiddenSymlinkInfo> list = Boolean.getBoolean("paper.disableWorldSymlinkValidation") ? List.of() : this.worldDirValidator.validateDirectory(path, true); // Paper - add skipping of symlinks scan
