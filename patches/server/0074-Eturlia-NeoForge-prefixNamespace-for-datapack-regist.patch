From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 6 Aug 2026 22:46:05 +0000
Subject: [PATCH] Eturlia: NeoForge prefixNamespace for datapack registry dirs

Registries.elementsDirPath/tagsDirPath must use CommonHooks.prefixNamespace
so modded registries (e.g. lithostitched:template_list) load from
data/<ns>/<registry_ns>/<registry_path>/ instead of data/<ns>/<path>/.
Without this, TEMPLATE_LIST stays empty and Lithostitched TemplateLists.getRandom NSEE kills Folia regions.

diff --git a/src/main/java/net/minecraft/core/registries/Registries.java b/src/main/java/net/minecraft/core/registries/Registries.java
--- a/src/main/java/net/minecraft/core/registries/Registries.java
+++ b/src/main/java/net/minecraft/core/registries/Registries.java
@@ -249,10 +249,12 @@ public class Registries {
     }
 
     public static String elementsDirPath(ResourceKey<? extends Registry<?>> registryRef) {
-        return registryRef.location().getPath();
+        // NeoForge: non-minecraft datapack registries live under namespace/path (e.g. lithostitched/template_list)
+        return net.neoforged.neoforge.common.CommonHooks.prefixNamespace(registryRef.location());
     }
 
     public static String tagsDirPath(ResourceKey<? extends Registry<?>> registryRef) {
-        return "tags/" + registryRef.location().getPath();
+        // NeoForge: same namespaced directory layout for tags
+        return "tags/" + net.neoforged.neoforge.common.CommonHooks.prefixNamespace(registryRef.location());
     }
 }
