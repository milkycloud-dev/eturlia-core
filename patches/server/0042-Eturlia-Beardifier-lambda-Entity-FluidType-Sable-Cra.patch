+        return new Beardifier(objectList.iterator(), objectList2.iterator());
+    }
+
+    // Eturlia: restored synthetic-shaped helper for Lithostitched WrapOperation
+    private static void lambda$forStructuresInChunk$2(
+        ChunkPos pos,
+        ObjectList<Beardifier.Rigid> objectList,
+        int i,
+        int j,
+        ObjectList<JigsawJunction> objectList2,
+        net.minecraft.world.level.levelgen.structure.StructureStart start
+    ) {
                     TerrainAdjustment terrainAdjustment = start.getStructure().terrainAdaptation();
 
                     for (StructurePiece structurePiece : start.getPieces()) {
@@ -66,8 +82,6 @@ public class Beardifier implements DensityFunctions.BeardifierOrMarker {
                             }
                         }
                     }
-        } // Paper - Perf: Remove streams from hot code
-        return new Beardifier(objectList.iterator(), objectList2.iterator());
