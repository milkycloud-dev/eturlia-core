From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 6 Aug 2026 20:07:00 +0000
Subject: [PATCH] Eturlia: Beardifier lambda + Entity FluidType + Sable
 CraftWorld guards

- Restore lambda$forStructuresInChunk$2 for Lithostitched BeardifierMixin
  (Paper inlined it away).
- Add NeoForge forgeFluidTypeHeight / setFluidTypeHeight on Entity for
  Sable swimming mixin shadows.
- Skip absurd Bukkit entity query AABBs (Sable sub-level coords) so
  arclight_sable_patch is unnecessary on Eturlia.

diff --git a/src/main/java/net/minecraft/world/entity/Entity.java b/src/main/java/net/minecraft/world/entity/Entity.java
--- a/src/main/java/net/minecraft/world/entity/Entity.java
+++ b/src/main/java/net/minecraft/world/entity/Entity.java
@@ -1927,6 +1927,9 @@ public abstract class Entity extends net.neoforged.neoforge.attachment.Attachmen
 
     protected boolean updateInWaterStateAndDoFluidPushing() {
         this.fluidHeight.clear();
+        if (this.forgeFluidTypeHeight != null) {
+            this.forgeFluidTypeHeight.clear(); // Eturlia/NeoForge
+        }
         this.updateInWaterStateAndDoWaterCurrentPushing();
         double d0 = this.level().dimensionType().ultraWarm() ? 0.007D : 0.0023333333333333335D;
         boolean flag = this.updateFluidHeightAndDoFluidPushing(FluidTags.LAVA, d0);
@@ -5795,4 +5798,44 @@ public abstract class Entity extends net.neoforged.neoforge.attachment.Attachmen
         }
         return this.persistentData;
     }
+
+    // Eturlia/NeoForge: FluidType height map (Sable EntityMixin shadows setFluidTypeHeight /
+    // forgeFluidTypeOnEyes). Mirrors NeoForge Entity patch without interface injection.
+    protected Object2DoubleMap<net.neoforged.neoforge.fluids.FluidType> forgeFluidTypeHeight = new Object2DoubleArrayMap<>(Math.max(2, net.neoforged.neoforge.fluids.FluidType.SIZE.get()));
+    private net.neoforged.neoforge.fluids.FluidType forgeFluidTypeOnEyes = net.neoforged.neoforge.common.NeoForgeMod.EMPTY_TYPE.value();
+
+    protected final void setFluidTypeHeight(net.neoforged.neoforge.fluids.FluidType type, double height) {
+        this.forgeFluidTypeHeight.put(type, height);
+    }
+
+    public final double getFluidTypeHeight(net.neoforged.neoforge.fluids.FluidType type) {
+        return this.forgeFluidTypeHeight.getDouble(type);
+    }
+
+    public final boolean isInFluidType(java.util.function.BiPredicate<net.neoforged.neoforge.fluids.FluidType, Double> predicate, boolean forAllTypes) {
+        if (this.forgeFluidTypeHeight.isEmpty()) {
+            return false;
+        }
+        return forAllTypes
+            ? this.forgeFluidTypeHeight.object2DoubleEntrySet().stream().allMatch(e -> predicate.test(e.getKey(), e.getDoubleValue()))
+            : this.forgeFluidTypeHeight.object2DoubleEntrySet().stream().anyMatch(e -> predicate.test(e.getKey(), e.getDoubleValue()));
+    }
+
+    public final boolean isInFluidType() {
+        return !this.forgeFluidTypeHeight.isEmpty();
+    }
+
+    public final net.neoforged.neoforge.fluids.FluidType getEyeInFluidType() {
+        return this.forgeFluidTypeOnEyes;
+    }
+
+    public net.neoforged.neoforge.fluids.FluidType getMaxHeightFluidType() {
+        if (this.forgeFluidTypeHeight.isEmpty()) {
+            return net.neoforged.neoforge.common.NeoForgeMod.EMPTY_TYPE.value();
+        }
+        return this.forgeFluidTypeHeight.object2DoubleEntrySet().stream()
+            .max(java.util.Comparator.comparingDouble(Object2DoubleMap.Entry::getDoubleValue))
+            .map(Object2DoubleMap.Entry::getKey)
+            .orElseGet(net.neoforged.neoforge.common.NeoForgeMod.EMPTY_TYPE::value);
+    }
 }
