From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 7 Aug 2026 12:48:38 +0000
Subject: [PATCH] Eturlia: HolderLookup.Provider.holder for Twilight Forest


diff --git a/src/main/java/net/minecraft/core/HolderLookup.java b/src/main/java/net/minecraft/core/HolderLookup.java
--- a/src/main/java/net/minecraft/core/HolderLookup.java
+++ b/src/main/java/net/minecraft/core/HolderLookup.java
@@ -35,6 +35,16 @@ public interface HolderLookup<T> extends HolderGetter<T> {
             return this.lookup(registryRef).orElseThrow(() -> new IllegalStateException("Registry " + registryRef.location() + " not found"));
         }
 
+        // Eturlia/NeoForge: IHolderLookupProviderExtension shortcuts (Twilight Forest TravellersModifiers)
+        default <T> Holder.Reference<T> holderOrThrow(ResourceKey<T> key) {
+            return this.lookupOrThrow(key.registryKey()).getOrThrow(key);
+        }
+
+        default <T> Optional<Holder.Reference<T>> holder(ResourceKey<T> key) {
+            Optional<HolderLookup.RegistryLookup<T>> registry = this.lookup(key.registryKey());
+            return registry.flatMap(tRegistryLookup -> tRegistryLookup.get(key));
+        }
+
         default <V> RegistryOps<V> createSerializationContext(DynamicOps<V> delegate) {
             return RegistryOps.create(delegate, this);
         }
