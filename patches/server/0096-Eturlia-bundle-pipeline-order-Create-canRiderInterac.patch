diff --git a/src/main/java/net/minecraft/network/RegistryFriendlyByteBuf.java b/src/main/java/net/minecraft/network/RegistryFriendlyByteBuf.java
new file mode 100644
index 0000000000000000000000000000000000000000..e987d7b5658cab351fee80d0f809726b98db412f
--- /dev/null
+++ b/src/main/java/net/minecraft/network/RegistryFriendlyByteBuf.java
@@ -0,0 +1,41 @@
+package net.minecraft.network;
+
+import io.netty.buffer.ByteBuf;
+import java.util.function.Function;
+import net.minecraft.core.RegistryAccess;
+
+public class RegistryFriendlyByteBuf extends FriendlyByteBuf {
+    private final RegistryAccess registryAccess;
+    // Eturlia - NeoForge reads the connection type off the buffer when encoding.
+    private final net.neoforged.neoforge.network.connection.ConnectionType eturlia$connectionType;
+
+    public RegistryFriendlyByteBuf(ByteBuf buf, RegistryAccess registryManager) {
+        super(buf);
+        this.registryAccess = registryManager;
+        this.eturlia$connectionType = net.neoforged.neoforge.network.connection.ConnectionType.OTHER;
+    }
+
+    // Eturlia - NeoForge overload: keep the negotiated connection type with the buffer.
+    public RegistryFriendlyByteBuf(ByteBuf buf, RegistryAccess registryManager, net.neoforged.neoforge.network.connection.ConnectionType connectionType) {
+        super(buf);
+        this.registryAccess = registryManager;
+        this.eturlia$connectionType = connectionType;
+    }
+
+    public net.neoforged.neoforge.network.connection.ConnectionType getConnectionType() {
+        return this.eturlia$connectionType;
+    }
+
+    public RegistryAccess registryAccess() {
+        return this.registryAccess;
+    }
+
+    public static Function<ByteBuf, RegistryFriendlyByteBuf> decorator(RegistryAccess registryManager) {
+        return buf -> new RegistryFriendlyByteBuf(buf, registryManager);
+    }
+
+    // Eturlia - NeoForge overload used once the connection type is known.
+    public static Function<ByteBuf, RegistryFriendlyByteBuf> decorator(RegistryAccess registries, net.neoforged.neoforge.network.connection.ConnectionType connectionType) {
+        return buf -> new RegistryFriendlyByteBuf(buf, registries, connectionType);
+    }
+}
diff --git a/src/main/java/net/minecraft/network/protocol/PacketFlow.java b/src/main/java/net/minecraft/network/protocol/PacketFlow.java
new file mode 100644
index 0000000000000000000000000000000000000000..6680413aa348d811913a881d9261cee3d314d340
--- /dev/null
+++ b/src/main/java/net/minecraft/network/protocol/PacketFlow.java
@@ -0,0 +1,29 @@
+package net.minecraft.network.protocol;
+
+public enum PacketFlow {
+    SERVERBOUND("serverbound"),
+    CLIENTBOUND("clientbound");
+
+    private final String id;
+
+    private PacketFlow(final String name) {
+        this.id = name;
+    }
+
+    public PacketFlow getOpposite() {
+        return this == CLIENTBOUND ? SERVERBOUND : CLIENTBOUND;
+    }
+
+    public String id() {
+        return this.id;
+    }
+
+    // Eturlia - NeoForge queries the direction while syncing registries
+    public boolean isClientbound() {
+        return this == CLIENTBOUND;
+    }
+
+    public boolean isServerbound() {
+        return this == SERVERBOUND;
+    }
+}
