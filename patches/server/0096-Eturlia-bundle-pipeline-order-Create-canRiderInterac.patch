+    public static Function<ByteBuf, RegistryFriendlyByteBuf> decorator(RegistryAccess registries, net.neoforged.neoforge.network.connection.ConnectionType connectionType) {
+        return buf -> new RegistryFriendlyByteBuf(buf, registries, connectionType);
+    }
 }
