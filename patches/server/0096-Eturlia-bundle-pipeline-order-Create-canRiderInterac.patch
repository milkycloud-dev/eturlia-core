diff --git a/src/main/java/net/minecraft/network/Connection.java b/src/main/java/net/minecraft/network/Connection.java
index e0ebfce6124a8beb8ff82d9c3552569d5c78649c..403ecccd46a360bd67201a0231da53e0da9c603b 100644
--- a/src/main/java/net/minecraft/network/Connection.java
+++ b/src/main/java/net/minecraft/network/Connection.java
@@ -414,7 +414,15 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
                 PacketBundleUnpacker packetbundleunpacker = new PacketBundleUnpacker(bundlerinfo);
 
                 unconfiguredpipelinehandler_d = unconfiguredpipelinehandler_d.andThen((channelhandlercontext) -> {
-                    channelhandlercontext.pipeline().addAfter("encoder", "unbundler", packetbundleunpacker);
+                    // Eturlia start - the unbundler has to see outbound packets before NeoForge's
+                    // splitter does. Both are installed with addAfter("encoder", ...), and outbound
+                    // traffic runs tail->head, so anchoring on the splitter (when NetworkFilters
+                    // injected one) is what puts the unbundler first.
+                    String anchor = channelhandlercontext.pipeline().get("neoforge:splitter") != null
+                            ? "neoforge:splitter"
+                            : "encoder";
+                    channelhandlercontext.pipeline().addAfter(anchor, "unbundler", packetbundleunpacker);
+                    // Eturlia end
                 });
             }
 
