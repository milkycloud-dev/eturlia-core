@@ -11,6 +11,18 @@ import net.minecraft.network.codec.StreamMemberEncoder;
 import net.minecraft.resources.ResourceLocation;
 
 public interface CustomPacketPayload {
+
+    // Eturlia start - NeoForge wraps its payloads into packets through these helpers; they are
+    // default methods on this interface upstream, so its payload classes never declare them.
+    default net.minecraft.network.protocol.common.ClientboundCustomPayloadPacket toVanillaClientbound() {
+        return new net.minecraft.network.protocol.common.ClientboundCustomPayloadPacket(this);
+    }
+
+    default net.minecraft.network.protocol.common.ServerboundCustomPayloadPacket toVanillaServerbound() {
+        return new net.minecraft.network.protocol.common.ServerboundCustomPayloadPacket(this);
+    }
+    // Eturlia end - NeoForge payload helpers
+
     CustomPacketPayload.Type<? extends CustomPacketPayload> type();
 
     static <B extends ByteBuf, T extends CustomPacketPayload> StreamCodec<B, T> codec(StreamMemberEncoder<B, T> encoder, StreamDecoder<B, T> decoder) {
@@ -34,7 +46,16 @@ public interface CustomPacketPayload {
                 // the vanilla discard path, or NeoForge payloads are cast to DiscardedPayload and
                 // the encoder kills the connection with an internal netty exception.
                 if (streamCodec == null) {
-                    streamCodec = net.neoforged.neoforge.network.registration.NetworkRegistry.getCodec(id, protocol, packetFlow);
+                    // The registry refuses unknown ids rather than returning null (it logs
+                    // "No registration for payload ..."), and CraftBukkit deliberately keeps the
+                    // known-type list empty so everything else becomes a DiscardedPayload for
+                    // plugins. Treat a refusal as "not mine" and let vanilla handle it —
+                    // otherwise minecraft:brand from a joining client kills the connection.
+                    try {
+                        streamCodec = net.neoforged.neoforge.network.registration.NetworkRegistry.getCodec(id, protocol, packetFlow);
+                    } catch (RuntimeException ignored) {
+                        streamCodec = null;
+                    }
                 }
                 // Eturlia end - NeoForge payload codecs
                 return streamCodec != null ? streamCodec : unknownCodecFactory.create(id);
@@ -43,8 +64,19 @@ public interface CustomPacketPayload {
             private <T extends CustomPacketPayload> void writeCap(B value, CustomPacketPayload.Type<T> id, CustomPacketPayload payload) {
                 value.writeResourceLocation(id.id());
                 @SuppressWarnings("unchecked") // Eturlia - decompiler dropped this cast; the file only compiles now that it is patched
-                StreamCodec<B, T> streamCodec = (StreamCodec<B, T>) this.findCodec(id.id);
-                streamCodec.encode(value, (T)payload);
+                // Eturlia - choose the codec by what we are actually holding, not by id
+                // alone: Paper sends minecraft:register for plugin channels as a
+                // DiscardedPayload while the same id also resolves to NeoForge's typed codec.
+                StreamCodec<B, T> streamCodec = payload instanceof DiscardedPayload
+                        ? (StreamCodec<B, T>) unknownCodecFactory.create(id.id())
+                        : (StreamCodec<B, T>) this.findCodec(id.id);
+                // Eturlia - name the payload in the failure: netty otherwise reports only
+                // "Failed to encode packet clientbound/minecraft:custom_payload".
+                try {
+                    streamCodec.encode(value, (T)payload);
+                } catch (RuntimeException e) {
+                    throw new RuntimeException("Failed encoding custom payload " + id.id() + ": " + e, e);
+                }
             }
 
             @Override
