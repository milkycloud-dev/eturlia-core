From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 7 Aug 2026 12:45:19 +0000
Subject: [PATCH] Eturlia: food properties API + timings ServerLevelData cast

Item/ItemStack getFoodProperties for quality_food; WorldTimingsHandler
uses ServerLevelData for Moonlight FakeServerLevel.

diff --git a/src/main/java/co/aikar/timings/WorldTimingsHandler.java b/src/main/java/co/aikar/timings/WorldTimingsHandler.java
index 2f0d9b953802dee821cfde82d22b0567cce8ee91..69f78a67a829543ba2a22a7eaa081e53d5e76bb3 100644
--- a/src/main/java/co/aikar/timings/WorldTimingsHandler.java
+++ b/src/main/java/co/aikar/timings/WorldTimingsHandler.java
@@ -60,7 +60,7 @@ public class WorldTimingsHandler {
     public final Timing miscMobSpawning;
 
     public WorldTimingsHandler(Level server) {
-        String name = ((PrimaryLevelData) server.getLevelData()).getLevelName() + " - ";
+        String name = ((net.minecraft.world.level.storage.ServerLevelData) server.getLevelData()).getLevelName() + " - "; // Eturlia: FakeServerLevel
 
         mobSpawn = Timings.ofSafe(name + "mobSpawn");
         doChunkUnload = Timings.ofSafe(name + "doChunkUnload");
@@ -115,6 +115,6 @@ public class WorldTimingsHandler {
     }
 
     public static Timing getTickList(ServerLevel worldserver, String timingsType) {
-        return Timings.ofSafe(((PrimaryLevelData) worldserver.getLevelData()).getLevelName() + " - Scheduled " + timingsType);
+        return Timings.ofSafe(((net.minecraft.world.level.storage.ServerLevelData) worldserver.getLevelData()).getLevelName() + " - Scheduled " + timingsType); // Eturlia
     }
 }
diff --git a/src/main/java/net/minecraft/world/item/Item.java b/src/main/java/net/minecraft/world/item/Item.java
--- a/src/main/java/net/minecraft/world/item/Item.java
+++ b/src/main/java/net/minecraft/world/item/Item.java
@@ -274,6 +274,12 @@ public class Item implements FeatureElement, ItemLike {
         return this.hasCraftingRemainingItem();
     }
 
+    // Eturlia/NeoForge: IItemExtension.getFoodProperties(ItemStack, LivingEntity)
+    @Nullable
+    public FoodProperties getFoodProperties(ItemStack stack, @Nullable net.minecraft.world.entity.LivingEntity entity) {
+        return stack.get(DataComponents.FOOD);
+    }
+
     // Eturlia/NeoForge: IItemExtension.canPerformAction — loot CanItemPerformAbility etc.
     public boolean canPerformAction(ItemStack stack, net.neoforged.neoforge.common.ItemAbility itemAbility) {
         return false;
diff --git a/src/main/java/net/minecraft/world/item/ItemStack.java b/src/main/java/net/minecraft/world/item/ItemStack.java
index 84e5121f7877c5443e18058436fa5faa34f41f89..8c26c7909f04a6b2c2af29f7c4b9487eacd2c852 100644
--- a/src/main/java/net/minecraft/world/item/ItemStack.java
+++ b/src/main/java/net/minecraft/world/item/ItemStack.java
@@ -1458,4 +1458,10 @@ public final class ItemStack implements DataComponentHolder {
     public boolean hasCraftingRemainingItem() {
         return this.getItem().hasCraftingRemainingItem(this);
     }
+
+    // Eturlia/NeoForge: IItemStackExtension.getFoodProperties(LivingEntity) — quality_food / food mods
+    @Nullable
+    public net.minecraft.world.food.FoodProperties getFoodProperties(@Nullable net.minecraft.world.entity.LivingEntity entity) {
+        return this.getItem().getFoodProperties(this, entity);
+    }
 }
