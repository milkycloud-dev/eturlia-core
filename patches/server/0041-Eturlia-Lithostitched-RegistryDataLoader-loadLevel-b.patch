From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Thu, 6 Aug 2026 20:02:24 +0000
Subject: [PATCH] Eturlia: Lithostitched RegistryDataLoader + loadLevel()
 bridges

Paper's Conversions param broke Lithostitched RegistryDataLoaderMixin
(vanilla 6-arg target). Restore 6-arg body with Decoder.parse and thread
Conversions from 7-arg callers. Restore no-arg loadLevel() for
DedicatedServerMixin At-target on Folia/CraftBukkit.

diff --git a/src/main/java/net/minecraft/resources/RegistryDataLoader.java b/src/main/java/net/minecraft/resources/RegistryDataLoader.java
index f1a5ffcf9eef3db38bd17bc2d2cfa9d02c5755fc..239e977689a9e973d71e1d4290501c07cc9e1bb4 100644
--- a/src/main/java/net/minecraft/resources/RegistryDataLoader.java
+++ b/src/main/java/net/minecraft/resources/RegistryDataLoader.java
@@ -194,16 +194,38 @@ public class RegistryDataLoader {
         LOGGER.error("Registry loading errors:\n{}", stringWriter);
     }
 
+    // Eturlia start - Lithostitched RegistryDataLoaderMixin targets the vanilla 6-arg signature
+    // (Paper added Conversions as a 7th param). Keep Decoder.parse in the 6-arg body so the
+    // mixin can inject/cancel load predicates, and thread Conversions from the 7-arg callers.
+    private static final ThreadLocal<io.papermc.paper.registry.data.util.Conversions> ETURLIA$LOAD_ELEMENT_CONVERSIONS = new ThreadLocal<>();
+
     private static <E> void loadElementFromResource(
-        WritableRegistry<E> registry, Decoder<E> decoder, RegistryOps<JsonElement> ops, ResourceKey<E> key, Resource resource, RegistrationInfo entryInfo, io.papermc.paper.registry.data.util.Conversions conversions
+        WritableRegistry<E> registry, Decoder<E> decoder, RegistryOps<JsonElement> ops, ResourceKey<E> key, Resource resource, RegistrationInfo entryInfo
     ) throws IOException {
         try (Reader reader = resource.openAsReader()) {
             JsonElement jsonElement = JsonParser.parseReader(reader);
             DataResult<E> dataResult = decoder.parse(ops, jsonElement);
             E object = dataResult.getOrThrow();
-            io.papermc.paper.registry.PaperRegistryListenerManager.INSTANCE.registerWithListeners(registry, key, object, entryInfo, conversions); // Paper - register with listeners
+            io.papermc.paper.registry.data.util.Conversions conversions = ETURLIA$LOAD_ELEMENT_CONVERSIONS.get();
+            if (conversions != null) {
+                io.papermc.paper.registry.PaperRegistryListenerManager.INSTANCE.registerWithListeners(registry, key, object, entryInfo, conversions); // Paper - register with listeners
+            } else {
+                registry.register(key, object, entryInfo);
+            }
+        }
+    }
+
+    private static <E> void loadElementFromResource(
+        WritableRegistry<E> registry, Decoder<E> decoder, RegistryOps<JsonElement> ops, ResourceKey<E> key, Resource resource, RegistrationInfo entryInfo, io.papermc.paper.registry.data.util.Conversions conversions
+    ) throws IOException {
+        ETURLIA$LOAD_ELEMENT_CONVERSIONS.set(conversions);
+        try {
+            loadElementFromResource(registry, decoder, ops, key, resource, entryInfo);
+        } finally {
+            ETURLIA$LOAD_ELEMENT_CONVERSIONS.remove();
         }
     }
+    // Eturlia end - Lithostitched RegistryDataLoaderMixin
 
     static <E> void loadContentsFromManager(
         ResourceManager resourceManager,
