#!/bin/bash

SESSION="test"
FLAGS="-Dmixin.env.ignoreRequired=true -Deturlia.lithostitched.allow-unsafe=true -Deturlia.compat.mixins=soft -Deturlia.compat.plugins=true -Deturlia.compat.registries=lenient -Deturlia.compat.modloading=lenient -Dforge.logging.mojang.level=debug -Xms2G -Xmx8G -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 --add-modules=jdk.incubator.vector"
start_server () {
    while true
    do
        java -server --add-modules=jdk.incubator.vector $FLAGS -jar eturlia.jar

        echo "Сервер останавливается или упал. Перезапуск через:"
        for i in 5 4 3 2 1
        do
            echo "$i..."
            sleep 1
        done
        echo "-- Перезапуск сервера --"
    done
}

if [ "$#" -eq 1 ] && [ "$1" == "inscreen" ]; then
    start_server
else
    # Проверяем, есть ли уже сессия screen
    if screen -list | grep -q "\.$SESSION\s"; then
        echo "Сессия screen $SESSION уже запущена. Присоединяемся."
        screen -r $SESSION
    else
        echo "Создаем новую сессию screen $SESSION и запускаем сервер.."
        screen -dmS $SESSION bash -c "bash $0 inscreen"
        screen -r $SESSION
    fi
fi
